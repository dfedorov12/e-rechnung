<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_erzeugen" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:error id="Error_Pruefung" name="Prüfung nicht bestanden" errorCode="PRUEFUNG" />
  <bpmn:collaboration id="Collab_erzeugen">
    <bpmn:participant id="P_Erz" name="Prüfen und E-Rechnung erzeugen" processRef="Process_ERechnung_Erzeugen" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ERechnung_Erzeugen" name="E-Rechnung Prüfen und erzeugen" isExecutable="false">
    <bpmn:documentation>Vor dem Export prüft der Konverter Pflichtfelder, IBAN, Summen und USt-IdNr. Danach entsteht die XML nach EN 16931, wird zurückgelesen und als ZUGFeRD oder XRechnung mit Prüfpfad ausgegeben.
Eingebunden in: E-Rechnung Rechnungsausgang.
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#ausgang
Im Einklang mit den Richtlinien: ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Erz">
      <bpmn:lane id="LXK" name="Konverter (Browser-App)"><bpmn:flowNodeRef>X_start</bpmn:flowNodeRef><bpmn:flowNodeRef>X_pflicht</bpmn:flowNodeRef><bpmn:flowNodeRef>X_pre</bpmn:flowNodeRef><bpmn:flowNodeRef>X_gwHard</bpmn:flowNodeRef><bpmn:flowNodeRef>X_err1</bpmn:flowNodeRef><bpmn:flowNodeRef>X_gwSoft</bpmn:flowNodeRef><bpmn:flowNodeRef>X_xml</bpmn:flowNodeRef><bpmn:flowNodeRef>X_self</bpmn:flowNodeRef><bpmn:flowNodeRef>X_gwSelf</bpmn:flowNodeRef><bpmn:flowNodeRef>X_err2</bpmn:flowNodeRef><bpmn:flowNodeRef>X_gwFmt</bpmn:flowNodeRef><bpmn:flowNodeRef>X_zf</bpmn:flowNodeRef><bpmn:flowNodeRef>X_xr</bpmn:flowNodeRef><bpmn:flowNodeRef>X_audit</bpmn:flowNodeRef><bpmn:flowNodeRef>X_dl</bpmn:flowNodeRef><bpmn:flowNodeRef>X_end</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LXV" name="Vertrieb / Fakturierung"><bpmn:flowNodeRef>X_confirm</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="X_start" name="Export angestoßen"><bpmn:outgoing>Flow_X_start_X_pflicht</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="X_pflicht" name="Pflichtfelder prüfen"><bpmn:incoming>Flow_X_start_X_pflicht</bpmn:incoming><bpmn:outgoing>Flow_X_pflicht_X_pre</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="X_pre" name="Vorab prüfen (IBAN-Prüfziffer, Summen, USt-IdNr-Format)"><bpmn:incoming>Flow_X_pflicht_X_pre</bpmn:incoming><bpmn:outgoing>Flow_X_pre_X_gwHard</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="X_gwHard" name="Harter Fehler?"><bpmn:incoming>Flow_X_pre_X_gwHard</bpmn:incoming><bpmn:outgoing>Flow_X_gwHard_X_err1</bpmn:outgoing><bpmn:outgoing>Flow_X_gwHard_X_gwSoft</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="X_err1" name="Prüfung nicht bestanden"><bpmn:incoming>Flow_X_gwHard_X_err1</bpmn:incoming><bpmn:errorEventDefinition id="X_err1_def" errorRef="Error_Pruefung" /></bpmn:endEvent>
      <bpmn:exclusiveGateway id="X_gwSoft" name="Abweichung zum Original-PDF?"><bpmn:incoming>Flow_X_gwHard_X_gwSoft</bpmn:incoming><bpmn:outgoing>Flow_X_gwSoft_X_xml</bpmn:outgoing><bpmn:outgoing>Flow_X_gwSoft_X_confirm</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="X_confirm" name="Warnung ansehen: fortfahren oder abbrechen"><bpmn:incoming>Flow_X_gwSoft_X_confirm</bpmn:incoming><bpmn:outgoing>Flow_X_confirm_X_xml</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="X_xml" name="XML nach EN 16931 erzeugen"><bpmn:incoming>Flow_X_gwSoft_X_xml</bpmn:incoming><bpmn:incoming>Flow_X_confirm_X_xml</bpmn:incoming><bpmn:outgoing>Flow_X_xml_X_self</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="X_self" name="Selbstprüfung: XML zurücklesen und vergleichen"><bpmn:incoming>Flow_X_xml_X_self</bpmn:incoming><bpmn:outgoing>Flow_X_self_X_gwSelf</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="X_gwSelf" name="Abweichung?"><bpmn:incoming>Flow_X_self_X_gwSelf</bpmn:incoming><bpmn:outgoing>Flow_X_gwSelf_X_err2</bpmn:outgoing><bpmn:outgoing>Flow_X_gwSelf_X_gwFmt</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="X_err2" name="Selbstprüfung fehlgeschlagen"><bpmn:incoming>Flow_X_gwSelf_X_err2</bpmn:incoming><bpmn:errorEventDefinition id="X_err2_def" errorRef="Error_Pruefung" /></bpmn:endEvent>
      <bpmn:exclusiveGateway id="X_gwFmt" name="Format?"><bpmn:incoming>Flow_X_gwSelf_X_gwFmt</bpmn:incoming><bpmn:outgoing>Flow_X_gwFmt_X_zf</bpmn:outgoing><bpmn:outgoing>Flow_X_gwFmt_X_xr</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="X_zf" name="ZUGFeRD-PDF/A-3b mit eingebetteter XML erzeugen"><bpmn:incoming>Flow_X_gwFmt_X_zf</bpmn:incoming><bpmn:outgoing>Flow_X_zf_X_audit</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="X_xr" name="XRechnung-XML und lesbares PDF erzeugen"><bpmn:incoming>Flow_X_gwFmt_X_xr</bpmn:incoming><bpmn:outgoing>Flow_X_xr_X_audit</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="X_audit" name="Prüfpfad schreiben (Hash, manuelle Änderungen, Prüfer)"><bpmn:incoming>Flow_X_zf_X_audit</bpmn:incoming><bpmn:incoming>Flow_X_xr_X_audit</bpmn:incoming><bpmn:outgoing>Flow_X_audit_X_dl</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="X_dl" name="Dateien zum Herunterladen bereitstellen"><bpmn:incoming>Flow_X_audit_X_dl</bpmn:incoming><bpmn:outgoing>Flow_X_dl_X_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="X_end" name="E-Rechnung erstellt"><bpmn:incoming>Flow_X_dl_X_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_X_start_X_pflicht" sourceRef="X_start" targetRef="X_pflicht" />
      <bpmn:sequenceFlow id="Flow_X_pflicht_X_pre" sourceRef="X_pflicht" targetRef="X_pre" />
      <bpmn:sequenceFlow id="Flow_X_pre_X_gwHard" sourceRef="X_pre" targetRef="X_gwHard" />
      <bpmn:sequenceFlow id="Flow_X_gwHard_X_err1" sourceRef="X_gwHard" targetRef="X_err1" name="ja" />
      <bpmn:sequenceFlow id="Flow_X_gwHard_X_gwSoft" sourceRef="X_gwHard" targetRef="X_gwSoft" name="nein" />
      <bpmn:sequenceFlow id="Flow_X_gwSoft_X_xml" sourceRef="X_gwSoft" targetRef="X_xml" name="nein" />
      <bpmn:sequenceFlow id="Flow_X_gwSoft_X_confirm" sourceRef="X_gwSoft" targetRef="X_confirm" name="ja" />
      <bpmn:sequenceFlow id="Flow_X_confirm_X_xml" sourceRef="X_confirm" targetRef="X_xml" name="fortfahren" />
      <bpmn:sequenceFlow id="Flow_X_xml_X_self" sourceRef="X_xml" targetRef="X_self" />
      <bpmn:sequenceFlow id="Flow_X_self_X_gwSelf" sourceRef="X_self" targetRef="X_gwSelf" />
      <bpmn:sequenceFlow id="Flow_X_gwSelf_X_err2" sourceRef="X_gwSelf" targetRef="X_err2" name="ja" />
      <bpmn:sequenceFlow id="Flow_X_gwSelf_X_gwFmt" sourceRef="X_gwSelf" targetRef="X_gwFmt" name="nein" />
      <bpmn:sequenceFlow id="Flow_X_gwFmt_X_zf" sourceRef="X_gwFmt" targetRef="X_zf" name="ZUGFeRD" />
      <bpmn:sequenceFlow id="Flow_X_gwFmt_X_xr" sourceRef="X_gwFmt" targetRef="X_xr" name="XRechnung" />
      <bpmn:sequenceFlow id="Flow_X_zf_X_audit" sourceRef="X_zf" targetRef="X_audit" />
      <bpmn:sequenceFlow id="Flow_X_xr_X_audit" sourceRef="X_xr" targetRef="X_audit" />
      <bpmn:sequenceFlow id="Flow_X_audit_X_dl" sourceRef="X_audit" targetRef="X_dl" />
      <bpmn:sequenceFlow id="Flow_X_dl_X_end" sourceRef="X_dl" targetRef="X_end" />
      <bpmn:textAnnotation id="XN_pre"><bpmn:text>Harte Fehler: IBAN-Prüfziffer falsch, Summe nicht plausibel, Netto + MwSt ≠ Brutto.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_XN_pre" associationDirection="None" sourceRef="X_pre" targetRef="XN_pre" />
      <bpmn:textAnnotation id="XN_confirm"><bpmn:text>„Abbrechen“ beendet den Export, es entsteht keine Datei.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_XN_confirm" associationDirection="None" sourceRef="X_confirm" targetRef="XN_confirm" />
      <bpmn:textAnnotation id="XN_zf"><bpmn:text>Standard: Das PDF wird aus den Rechnungsdaten erzeugt, PDF und XML sind identisch.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_XN_zf" associationDirection="None" sourceRef="X_zf" targetRef="XN_zf" />
  </bpmn:process>
