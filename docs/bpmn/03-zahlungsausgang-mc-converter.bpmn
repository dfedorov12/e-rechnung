<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_zahlung" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_zahlung">
    <bpmn:participant id="P_Zahl" name="DIHAG · Zahlungslauf (je Werk)" processRef="Process_Zahlungsausgang_MC" />
    <bpmn:participant id="P_Bank" name="Hausbank" />
    <bpmn:messageFlow id="Msg_T_up_P_Bank" name="pain.001.001.09 (CCT oder AXZ)" sourceRef="T_up" targetRef="P_Bank" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Zahlungsausgang_MC" name="Zahlungsausgang (MC-Converter)" isExecutable="false">
    <bpmn:documentation>Zahldateien aus ERP und MultiCash gehen durch den MC-Converter: SEPA-Überweisungen werden zu pain.001.001.09, Auslandszahlungen im DTAZV-Format zu pain.001.001.09 AXZ. Erst nach grünem Preflight lädt die Treasury hoch.
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#zahlung
Im Einklang mit den Richtlinien: ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Zahl">
      <bpmn:lane id="LE" name="ERP / MultiCash"><bpmn:flowNodeRef>Z_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_vor</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_exp</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LM" name="MC-Converter (Browser-App)"><bpmn:flowNodeRef>M_load</bpmn:flowNodeRef><bpmn:flowNodeRef>M_conv</bpmn:flowNodeRef><bpmn:flowNodeRef>M_pre</bpmn:flowNodeRef><bpmn:flowNodeRef>M_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>M_dl</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LT" name="Treasury / Buchhaltung"><bpmn:flowNodeRef>T_fix</bpmn:flowNodeRef><bpmn:flowNodeRef>T_up</bpmn:flowNodeRef><bpmn:flowNodeRef>T_end</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Z_start" name="Zahllauf ist fällig"><bpmn:outgoing>Flow_Z_start_Z_vor</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="Z_vor" name="Zahlungsvorschlag erstellen und freigeben"><bpmn:incoming>Flow_Z_start_Z_vor</bpmn:incoming><bpmn:outgoing>Flow_Z_vor_Z_exp</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="Z_exp" name="Zahldatei exportieren (SEPA oder DTAZV)"><bpmn:incoming>Flow_Z_vor_Z_exp</bpmn:incoming><bpmn:incoming>Flow_T_fix_Z_exp</bpmn:incoming><bpmn:outgoing>Flow_Z_exp_M_load</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="M_load" name="Datei in den MC-Converter laden (Endung egal)"><bpmn:incoming>Flow_Z_exp_M_load</bpmn:incoming><bpmn:outgoing>Flow_M_load_M_conv</bpmn:outgoing></bpmn:userTask>
      <bpmn:callActivity id="M_conv" name="Auf pain.001.001.09 umstellen" calledElement="Process_Zahldatei_Umstellen"><bpmn:documentation>Unterprozess: Zahldatei auf pain.001.001.09 umstellen
[[rms:modell=01NH6NP5CJ56ANY7PSDBGJSCNFYTCNWSHF]]</bpmn:documentation><bpmn:incoming>Flow_M_load_M_conv</bpmn:incoming><bpmn:outgoing>Flow_M_conv_M_pre</bpmn:outgoing></bpmn:callActivity>
      <bpmn:callActivity id="M_pre" name="Preflight" calledElement="Process_Zahldatei_Preflight"><bpmn:documentation>Unterprozess: Zahldatei-Preflight
[[rms:modell=01NH6NP5CKDDMZSL7NZVBYST7STODAYBJC]]</bpmn:documentation><bpmn:incoming>Flow_M_conv_M_pre</bpmn:incoming><bpmn:outgoing>Flow_M_pre_M_gw</bpmn:outgoing></bpmn:callActivity>
      <bpmn:exclusiveGateway id="M_gw" name="Preflight grün?"><bpmn:incoming>Flow_M_pre_M_gw</bpmn:incoming><bpmn:outgoing>Flow_M_gw_M_dl</bpmn:outgoing><bpmn:outgoing>Flow_M_gw_T_fix</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="T_fix" name="Ursache im ERP oder in MultiCash korrigieren"><bpmn:incoming>Flow_M_gw_T_fix</bpmn:incoming><bpmn:outgoing>Flow_T_fix_Z_exp</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="M_dl" name="pain.001.001.09 herunterladen"><bpmn:incoming>Flow_M_gw_M_dl</bpmn:incoming><bpmn:outgoing>Flow_M_dl_T_up</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="T_up" name="Per EBICS hochladen (CCT oder AXZ) und im Vier-Augen-Prinzip freigeben"><bpmn:incoming>Flow_M_dl_T_up</bpmn:incoming><bpmn:outgoing>Flow_T_up_T_end</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="T_end" name="Zahlung beauftragt"><bpmn:incoming>Flow_T_up_T_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Z_start_Z_vor" sourceRef="Z_start" targetRef="Z_vor" />
      <bpmn:sequenceFlow id="Flow_Z_vor_Z_exp" sourceRef="Z_vor" targetRef="Z_exp" />
      <bpmn:sequenceFlow id="Flow_Z_exp_M_load" sourceRef="Z_exp" targetRef="M_load" />
      <bpmn:sequenceFlow id="Flow_M_load_M_conv" sourceRef="M_load" targetRef="M_conv" />
      <bpmn:sequenceFlow id="Flow_M_conv_M_pre" sourceRef="M_conv" targetRef="M_pre" />
      <bpmn:sequenceFlow id="Flow_M_pre_M_gw" sourceRef="M_pre" targetRef="M_gw" />
      <bpmn:sequenceFlow id="Flow_M_gw_M_dl" sourceRef="M_gw" targetRef="M_dl" name="ja" />
      <bpmn:sequenceFlow id="Flow_M_gw_T_fix" sourceRef="M_gw" targetRef="T_fix" name="nein" />
      <bpmn:sequenceFlow id="Flow_T_fix_Z_exp" sourceRef="T_fix" targetRef="Z_exp" name="neu exportieren" />
      <bpmn:sequenceFlow id="Flow_M_dl_T_up" sourceRef="M_dl" targetRef="T_up" />
      <bpmn:sequenceFlow id="Flow_T_up_T_end" sourceRef="T_up" targetRef="T_end" />
      <bpmn:textAnnotation id="N_local"><bpmn:text>Läuft komplett im Browser. Die Zahldatei verlässt den Rechner nicht.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_local" associationDirection="None" sourceRef="M_load" targetRef="N_local" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_zahlung">
    <bpmndi:BPMNPlane id="Plane_zahlung" bpmnElement="Collab_zahlung">
      <bpmndi:BPMNShape id="P_Zahl_di" bpmnElement="P_Zahl" isHorizontal="true" bioc:stroke="#1A2644" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" color:border-color="#1A2644"><dc:Bounds x="100" y="60" width="1810" height="540" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LE_di" bpmnElement="LE" isHorizontal="true" bioc:stroke="#424241" bioc:fill="#F7F7F6" color:background-color="#F7F7F6" color:border-color="#424241"><dc:Bounds x="130" y="60" width="1780" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LM_di" bpmnElement="LM" isHorizontal="true" bioc:stroke="#1A2644" bioc:fill="#F3F6FB" color:background-color="#F3F6FB" color:border-color="#1A2644"><dc:Bounds x="130" y="200" width="1780" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LT_di" bpmnElement="LT" isHorizontal="true" bioc:stroke="#C2410C" bioc:fill="#FFF8F1" color:background-color="#FFF8F1" color:border-color="#C2410C"><dc:Bounds x="130" y="460" width="1780" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Bank_di" bpmnElement="P_Bank" isHorizontal="true" bioc:stroke="#5B6472" bioc:fill="#F6F7F9" color:background-color="#F6F7F9" color:border-color="#5B6472"><dc:Bounds x="100" y="670" width="1810" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_start_di" bpmnElement="Z_start" bioc:stroke="#1E7B3A" bioc:fill="#DDF3E4" color:background-color="#DDF3E4" color:border-color="#1E7B3A"><dc:Bounds x="247" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="205" y="153" width="120" height="15" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_vor_di" bpmnElement="Z_vor" bioc:stroke="#424241" bioc:fill="#E6E6E4" color:background-color="#E6E6E4" color:border-color="#424241"><dc:Bounds x="369" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_exp_di" bpmnElement="Z_exp" bioc:stroke="#424241" bioc:fill="#E6E6E4" color:background-color="#E6E6E4" color:border-color="#424241"><dc:Bounds x="539" y="88" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_load_di" bpmnElement="M_load" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="709" y="228" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_conv_di" bpmnElement="M_conv" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="879" y="228" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_pre_di" bpmnElement="M_pre" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="1049" y="228" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_gw_di" bpmnElement="M_gw" isMarkerVisible="true" bioc:stroke="#8A6100" bioc:fill="#FFF8DB" color:background-color="#FFF8DB" color:border-color="#8A6100"><dc:Bounds x="1260" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1185" y="226" width="96" height="15" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_fix_di" bpmnElement="T_fix" bioc:stroke="#A65F00" bioc:fill="#FFF1CC" color:background-color="#FFF1CC" color:border-color="#A65F00"><dc:Bounds x="1219" y="488" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_dl_di" bpmnElement="M_dl" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="1389" y="228" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_up_di" bpmnElement="T_up" bioc:stroke="#C2410C" bioc:fill="#FFE3C8" color:background-color="#FFE3C8" color:border-color="#C2410C"><dc:Bounds x="1559" y="488" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_end_di" bpmnElement="T_end" bioc:stroke="#1E7B3A" bioc:fill="#DDF3E4" color:background-color="#DDF3E4" color:border-color="#1E7B3A"><dc:Bounds x="1777" y="512" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1735" y="553" width="120" height="15" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Z_start_Z_vor_di" bpmnElement="Flow_Z_start_Z_vor"><di:waypoint x="283" y="130" /><di:waypoint x="369" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Z_vor_Z_exp_di" bpmnElement="Flow_Z_vor_Z_exp"><di:waypoint x="501" y="130" /><di:waypoint x="539" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Z_exp_M_load_di" bpmnElement="Flow_Z_exp_M_load"><di:waypoint x="671" y="130" /><di:waypoint x="690" y="130" /><di:waypoint x="690" y="270" /><di:waypoint x="709" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M_load_M_conv_di" bpmnElement="Flow_M_load_M_conv"><di:waypoint x="841" y="270" /><di:waypoint x="879" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M_conv_M_pre_di" bpmnElement="Flow_M_conv_M_pre"><di:waypoint x="1011" y="270" /><di:waypoint x="1049" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M_pre_M_gw_di" bpmnElement="Flow_M_pre_M_gw"><di:waypoint x="1181" y="270" /><di:waypoint x="1260" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M_gw_M_dl_di" bpmnElement="Flow_M_gw_M_dl"><di:waypoint x="1310" y="270" /><di:waypoint x="1389" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="1316" y="253" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M_gw_T_fix_di" bpmnElement="Flow_M_gw_T_fix"><di:waypoint x="1285" y="295" /><di:waypoint x="1285" y="488" /><bpmndi:BPMNLabel><dc:Bounds x="1291" y="385" width="38" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_fix_Z_exp_di" bpmnElement="Flow_T_fix_Z_exp"><di:waypoint x="1219" y="530" /><di:waypoint x="605" y="530" /><di:waypoint x="605" y="172" /><bpmndi:BPMNLabel><dc:Bounds x="1105" y="513" width="108" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M_dl_T_up_di" bpmnElement="Flow_M_dl_T_up"><di:waypoint x="1521" y="270" /><di:waypoint x="1540" y="270" /><di:waypoint x="1540" y="530" /><di:waypoint x="1559" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_up_T_end_di" bpmnElement="Flow_T_up_T_end"><di:waypoint x="1691" y="530" /><di:waypoint x="1777" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="N_local_di" bpmnElement="N_local" bioc:stroke="#6B7280" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" color:border-color="#6B7280"><dc:Bounds x="700" y="362" width="280" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Assoc_N_local_di" bpmnElement="Assoc_N_local"><di:waypoint x="775" y="312" /><di:waypoint x="775" y="362" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_T_up_P_Bank_di" bpmnElement="Msg_T_up_P_Bank"><di:waypoint x="1625" y="572" /><di:waypoint x="1625" y="670" /><bpmndi:BPMNLabel><dc:Bounds x="1633" y="621" width="170" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
