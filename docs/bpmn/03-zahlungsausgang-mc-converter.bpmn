<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Zahlung" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Zahlung">
    <bpmn:participant id="P_Zahl" name="DIHAG · Zahlungslauf (je Werk)" processRef="Proc_P_Zahl" />
    <bpmn:participant id="P_Bank" name="Hausbank" processRef="Proc_P_Bank" />
    <bpmn:messageFlow id="Msg_T_up_H_recv" name="pain.001.001.09" sourceRef="T_up" targetRef="H_recv" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_Zahl" name="DIHAG · Zahlungslauf (je Werk)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_Zahl">
      <bpmn:lane id="LE" name="ERP / MultiCash"><bpmn:flowNodeRef>Z_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_vor</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_exp</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LM" name="MC-Converter (Browser-App)"><bpmn:flowNodeRef>M_load</bpmn:flowNodeRef><bpmn:flowNodeRef>M_conv</bpmn:flowNodeRef><bpmn:flowNodeRef>M_pre</bpmn:flowNodeRef><bpmn:flowNodeRef>M_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>M_dl</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LT" name="Treasury / Buchhaltung"><bpmn:flowNodeRef>T_fix</bpmn:flowNodeRef><bpmn:flowNodeRef>T_up</bpmn:flowNodeRef><bpmn:flowNodeRef>T_end</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="Z_start" name="Zahllauf ist fällig"><bpmn:outgoing>Flow_Z_start_Z_vor</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="Z_vor" name="Zahlungsvorschlag erstellen und freigeben"><bpmn:incoming>Flow_Z_start_Z_vor</bpmn:incoming><bpmn:outgoing>Flow_Z_vor_Z_exp</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="Z_exp" name="SEPA-Datei exportieren (pain.001.003.03 oder 001.001.03)"><bpmn:incoming>Flow_Z_vor_Z_exp</bpmn:incoming><bpmn:incoming>Flow_T_fix_Z_exp</bpmn:incoming><bpmn:outgoing>Flow_Z_exp_M_load</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="M_load" name="Datei in den MC-Converter laden (Endung egal)"><bpmn:incoming>Flow_Z_exp_M_load</bpmn:incoming><bpmn:outgoing>Flow_M_load_M_conv</bpmn:outgoing></bpmn:userTask>
      <bpmn:subProcess id="M_conv" name="Auf pain.001.001.09 umstellen"><bpmn:incoming>Flow_M_load_M_conv</bpmn:incoming><bpmn:outgoing>Flow_M_conv_M_pre</bpmn:outgoing>
      <bpmn:startEvent id="U_start" name="Datei geladen"><bpmn:outgoing>Flow_U_start_U_ns</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="U_ns" name="Nachrichtentyp erkennen (Namespace)"><bpmn:incoming>Flow_U_start_U_ns</bpmn:incoming><bpmn:outgoing>Flow_U_ns_U_gw</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="U_gw" name="SEPA-Überweisung (pain.001)?"><bpmn:incoming>Flow_U_ns_U_gw</bpmn:incoming><bpmn:outgoing>Flow_U_gw_U_stop</bpmn:outgoing><bpmn:outgoing>Flow_U_gw_U_struct</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="U_stop" name="Abbruch: keine Überweisung, z. B. Lastschrift pain.008"><bpmn:incoming>Flow_U_gw_U_stop</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="U_struct" name="Struktur umstellen: Datum als &lt;Dt&gt;, BIC als &lt;BICFI&gt;, Sammelbuchung"><bpmn:incoming>Flow_U_gw_U_struct</bpmn:incoming><bpmn:outgoing>Flow_U_struct_U_strip</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="U_strip" name="Adressen und Konto-Währung entfernen (IBAN genügt)"><bpmn:incoming>Flow_U_struct_U_strip</bpmn:incoming><bpmn:outgoing>Flow_U_strip_U_sum</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="U_sum" name="Anzahl und Kontrollsumme aus den Posten neu berechnen"><bpmn:incoming>Flow_U_strip_U_sum</bpmn:incoming><bpmn:outgoing>Flow_U_sum_U_clean</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="U_clean" name="SEPA-Zeichensatz erzwingen, Verwendungszweck max. 140 Zeichen"><bpmn:incoming>Flow_U_sum_U_clean</bpmn:incoming><bpmn:outgoing>Flow_U_clean_U_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="U_end" name="pain.001.001.09 erzeugt"><bpmn:incoming>Flow_U_clean_U_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_U_start_U_ns" sourceRef="U_start" targetRef="U_ns" />
      <bpmn:sequenceFlow id="Flow_U_ns_U_gw" sourceRef="U_ns" targetRef="U_gw" />
      <bpmn:sequenceFlow id="Flow_U_gw_U_stop" sourceRef="U_gw" targetRef="U_stop" name="nein" />
      <bpmn:sequenceFlow id="Flow_U_gw_U_struct" sourceRef="U_gw" targetRef="U_struct" name="ja" />
      <bpmn:sequenceFlow id="Flow_U_struct_U_strip" sourceRef="U_struct" targetRef="U_strip" />
      <bpmn:sequenceFlow id="Flow_U_strip_U_sum" sourceRef="U_strip" targetRef="U_sum" />
      <bpmn:sequenceFlow id="Flow_U_sum_U_clean" sourceRef="U_sum" targetRef="U_clean" />
      <bpmn:sequenceFlow id="Flow_U_clean_U_end" sourceRef="U_clean" targetRef="U_end" />
      <bpmn:textAnnotation id="UN_ns"><bpmn:text>Liest über die Elementnamen, egal ob 001.003.03 oder 001.001.03.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_UN_ns" associationDirection="None" sourceRef="U_ns" targetRef="UN_ns" />
      <bpmn:textAnnotation id="UN_struct"><bpmn:text>Im Reiter umschaltbar: Sammelbuchung, InstrId übernehmen, Zeichensatz.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_UN_struct" associationDirection="None" sourceRef="U_struct" targetRef="UN_struct" />
      </bpmn:subProcess>
      <bpmn:subProcess id="M_pre" name="SEPA-Preflight"><bpmn:incoming>Flow_M_conv_M_pre</bpmn:incoming><bpmn:outgoing>Flow_M_pre_M_gw</bpmn:outgoing>
      <bpmn:startEvent id="P_start" name="umgestellte Datei"><bpmn:outgoing>Flow_P_start_P_split</bpmn:outgoing></bpmn:startEvent>
      <bpmn:parallelGateway id="P_split"><bpmn:incoming>Flow_P_start_P_split</bpmn:incoming><bpmn:outgoing>Flow_P_split_P_iban</bpmn:outgoing><bpmn:outgoing>Flow_P_split_P_bic</bpmn:outgoing><bpmn:outgoing>Flow_P_split_P_sum</bpmn:outgoing><bpmn:outgoing>Flow_P_split_P_txt</bpmn:outgoing><bpmn:outgoing>Flow_P_split_P_date</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:serviceTask id="P_iban" name="IBAN-Prüfziffer (Mod-97) je Konto"><bpmn:incoming>Flow_P_split_P_iban</bpmn:incoming><bpmn:outgoing>Flow_P_iban_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="P_bic" name="BIC-Format"><bpmn:incoming>Flow_P_split_P_bic</bpmn:incoming><bpmn:outgoing>Flow_P_bic_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="P_sum" name="Anzahl und Kontrollsumme gleich den Posten"><bpmn:incoming>Flow_P_split_P_sum</bpmn:incoming><bpmn:outgoing>Flow_P_sum_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="P_txt" name="EUR, SEPA-Zeichensatz, Feldlängen"><bpmn:incoming>Flow_P_split_P_txt</bpmn:incoming><bpmn:outgoing>Flow_P_txt_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="P_date" name="Ausführungsdatum"><bpmn:incoming>Flow_P_split_P_date</bpmn:incoming><bpmn:outgoing>Flow_P_date_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:parallelGateway id="P_join"><bpmn:incoming>Flow_P_iban_P_join</bpmn:incoming><bpmn:incoming>Flow_P_bic_P_join</bpmn:incoming><bpmn:incoming>Flow_P_sum_P_join</bpmn:incoming><bpmn:incoming>Flow_P_txt_P_join</bpmn:incoming><bpmn:incoming>Flow_P_date_P_join</bpmn:incoming><bpmn:outgoing>Flow_P_join_P_gw</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:exclusiveGateway id="P_gw" name="Fehler gefunden?"><bpmn:incoming>Flow_P_join_P_gw</bpmn:incoming><bpmn:outgoing>Flow_P_gw_P_green</bpmn:outgoing><bpmn:outgoing>Flow_P_gw_P_red</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="P_green" name="grün: bankfertig"><bpmn:incoming>Flow_P_gw_P_green</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="P_red" name="rot: nicht bankfertig"><bpmn:incoming>Flow_P_gw_P_red</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_P_start_P_split" sourceRef="P_start" targetRef="P_split" />
      <bpmn:sequenceFlow id="Flow_P_split_P_iban" sourceRef="P_split" targetRef="P_iban" />
      <bpmn:sequenceFlow id="Flow_P_split_P_bic" sourceRef="P_split" targetRef="P_bic" />
      <bpmn:sequenceFlow id="Flow_P_split_P_sum" sourceRef="P_split" targetRef="P_sum" />
      <bpmn:sequenceFlow id="Flow_P_split_P_txt" sourceRef="P_split" targetRef="P_txt" />
      <bpmn:sequenceFlow id="Flow_P_split_P_date" sourceRef="P_split" targetRef="P_date" />
      <bpmn:sequenceFlow id="Flow_P_iban_P_join" sourceRef="P_iban" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_bic_P_join" sourceRef="P_bic" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_sum_P_join" sourceRef="P_sum" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_txt_P_join" sourceRef="P_txt" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_date_P_join" sourceRef="P_date" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_join_P_gw" sourceRef="P_join" targetRef="P_gw" />
      <bpmn:sequenceFlow id="Flow_P_gw_P_green" sourceRef="P_gw" targetRef="P_green" name="nein" />
      <bpmn:sequenceFlow id="Flow_P_gw_P_red" sourceRef="P_gw" targetRef="P_red" name="ja" />
      <bpmn:textAnnotation id="PN_date"><bpmn:text>Ein Datum in der Vergangenheit ist nur ein Hinweis. Die Bank bucht am nächsten Bankarbeitstag.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_PN_date" associationDirection="None" sourceRef="P_date" targetRef="PN_date" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="M_gw" name="Preflight grün?"><bpmn:incoming>Flow_M_pre_M_gw</bpmn:incoming><bpmn:outgoing>Flow_M_gw_M_dl</bpmn:outgoing><bpmn:outgoing>Flow_M_gw_T_fix</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="T_fix" name="Ursache im ERP oder in MultiCash korrigieren"><bpmn:incoming>Flow_M_gw_T_fix</bpmn:incoming><bpmn:outgoing>Flow_T_fix_Z_exp</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="M_dl" name="pain.001.001.09 herunterladen"><bpmn:incoming>Flow_M_gw_M_dl</bpmn:incoming><bpmn:outgoing>Flow_M_dl_T_up</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="T_up" name="Im Banking-Portal oder per EBICS hochladen, Vier-Augen-Freigabe"><bpmn:incoming>Flow_M_dl_T_up</bpmn:incoming><bpmn:outgoing>Flow_T_up_T_end</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="T_end" name="Zahlung beauftragt"><bpmn:incoming>Flow_T_up_T_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Z_start_Z_vor" sourceRef="Z_start" targetRef="Z_vor" />
      <bpmn:sequenceFlow id="Flow_Z_vor_Z_exp" sourceRef="Z_vor" targetRef="Z_exp" />
      <bpmn:sequenceFlow id="Flow_Z_exp_M_load" sourceRef="Z_exp" targetRef="M_load" />
      <bpmn:sequenceFlow id="Flow_M_load_M_conv" sourceRef="M_load" targetRef="M_conv" />
      <bpmn:sequenceFlow id="Flow_M_conv_M_pre" sourceRef="M_conv" targetRef="M_pre" />
      <bpmn:sequenceFlow id="Flow_M_pre_M_gw" sourceRef="M_pre" targetRef="M_gw" />
      <bpmn:sequenceFlow id="Flow_M_gw_M_dl" sourceRef="M_gw" targetRef="M_dl" name="ja" />
      <bpmn:sequenceFlow id="Flow_M_gw_T_fix" sourceRef="M_gw" targetRef="T_fix" name="nein" />
      <bpmn:sequenceFlow id="Flow_T_fix_Z_exp" sourceRef="T_fix" targetRef="Z_exp" name="neu exportieren" />
      <bpmn:sequenceFlow id="Flow_M_dl_T_up" sourceRef="M_dl" targetRef="T_up" />
      <bpmn:sequenceFlow id="Flow_T_up_T_end" sourceRef="T_up" targetRef="T_end" />
      <bpmn:textAnnotation id="N_local"><bpmn:text>Läuft komplett im Browser. Die Zahldatei verlässt den Rechner nicht.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_local" associationDirection="None" sourceRef="M_load" targetRef="N_local" />
  </bpmn:process>
  <bpmn:process id="Proc_P_Bank" name="Hausbank" isExecutable="false">
      <bpmn:startEvent id="H_recv" name="Zahlungsauftrag erhalten"><bpmn:outgoing>Flow_H_recv_H_exec</bpmn:outgoing><bpmn:messageEventDefinition id="H_recv_def" /></bpmn:startEvent>
      <bpmn:serviceTask id="H_exec" name="Überweisungen ausführen"><bpmn:incoming>Flow_H_recv_H_exec</bpmn:incoming><bpmn:outgoing>Flow_H_exec_H_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="H_end" name="ausgeführt"><bpmn:incoming>Flow_H_exec_H_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_H_recv_H_exec" sourceRef="H_recv" targetRef="H_exec" />
      <bpmn:sequenceFlow id="Flow_H_exec_H_end" sourceRef="H_exec" targetRef="H_end" />
  </bpmn:process>
