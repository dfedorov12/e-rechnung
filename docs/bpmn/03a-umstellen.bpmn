<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_umstellen" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_umstellen">
    <bpmn:participant id="P_Umst" name="Zahldatei umstellen" processRef="Process_Zahldatei_Umstellen" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Zahldatei_Umstellen" name="Zahldatei auf pain.001.001.09 umstellen" isExecutable="false">
    <bpmn:documentation>Der MC-Converter erkennt die Dateiart am Inhalt. SEPA-Überweisungen (pain.001.003.03 oder 001.001.03) werden zu pain.001.001.09, DTAZV-Auslandszahlungen zu pain.001.001.09 AXZ nach DK-Schema GBIC_5.
Eingebunden in: Zahlungsausgang (MC-Converter).
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#zahlung
Im Einklang mit den Richtlinien: ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Umst">
      <bpmn:lane id="LUM" name="MC-Converter (Browser-App)"><bpmn:flowNodeRef>U_start</bpmn:flowNodeRef><bpmn:flowNodeRef>U_ns</bpmn:flowNodeRef><bpmn:flowNodeRef>U_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>U_stop</bpmn:flowNodeRef><bpmn:flowNodeRef>U_struct</bpmn:flowNodeRef><bpmn:flowNodeRef>U_strip</bpmn:flowNodeRef><bpmn:flowNodeRef>U_sum</bpmn:flowNodeRef><bpmn:flowNodeRef>U_clean</bpmn:flowNodeRef><bpmn:flowNodeRef>U_end</bpmn:flowNodeRef><bpmn:flowNodeRef>U_read</bpmn:flowNodeRef><bpmn:flowNodeRef>U_map</bpmn:flowNodeRef><bpmn:flowNodeRef>U_iban</bpmn:flowNodeRef><bpmn:flowNodeRef>U_adr</bpmn:flowNodeRef><bpmn:flowNodeRef>U_gwOrt</bpmn:flowNodeRef><bpmn:flowNodeRef>U_endAxz</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LUT" name="Treasury / Buchhaltung"><bpmn:flowNodeRef>U_ort</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="U_start" name="Datei geladen"><bpmn:outgoing>Flow_U_start_U_ns</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="U_ns" name="Dateiart erkennen (pain.001-Namespace oder DTAZV-Vorsatz)"><bpmn:incoming>Flow_U_start_U_ns</bpmn:incoming><bpmn:outgoing>Flow_U_ns_U_gw</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="U_gw" name="Welche Dateiart?"><bpmn:incoming>Flow_U_ns_U_gw</bpmn:incoming><bpmn:outgoing>Flow_U_gw_U_struct</bpmn:outgoing><bpmn:outgoing>Flow_U_gw_U_read</bpmn:outgoing><bpmn:outgoing>Flow_U_gw_U_stop</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="U_stop" name="Abbruch: keine Überweisung, z. B. Lastschrift pain.008"><bpmn:incoming>Flow_U_gw_U_stop</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="U_struct" name="Struktur umstellen (Datum als &lt;Dt&gt;, BIC als &lt;BICFI&gt;, Sammelbuchung)"><bpmn:incoming>Flow_U_gw_U_struct</bpmn:incoming><bpmn:outgoing>Flow_U_struct_U_strip</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="U_strip" name="Adressen und Konto-Währung entfernen (IBAN genügt)"><bpmn:incoming>Flow_U_struct_U_strip</bpmn:incoming><bpmn:outgoing>Flow_U_strip_U_sum</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="U_sum" name="Anzahl und Kontrollsumme aus den Posten neu berechnen"><bpmn:incoming>Flow_U_strip_U_sum</bpmn:incoming><bpmn:outgoing>Flow_U_sum_U_clean</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="U_clean" name="SEPA-Zeichensatz erzwingen (Verwendungszweck max. 140 Zeichen)"><bpmn:incoming>Flow_U_sum_U_clean</bpmn:incoming><bpmn:outgoing>Flow_U_clean_U_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="U_end" name="pain.001.001.09 (SEPA) erzeugt"><bpmn:incoming>Flow_U_clean_U_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="U_read" name="Q-, T- und Z-Sätze lesen und Nachsatz gegenprüfen"><bpmn:incoming>Flow_U_gw_U_read</bpmn:incoming><bpmn:outgoing>Flow_U_read_U_map</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="U_map" name="Entgelt, Zahlungsart und Weisungen auf AXZ abbilden"><bpmn:incoming>Flow_U_read_U_map</bpmn:incoming><bpmn:outgoing>Flow_U_map_U_iban</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="U_iban" name="IBAN des Belastungskontos aus BLZ und Konto berechnen"><bpmn:incoming>Flow_U_map_U_iban</bpmn:incoming><bpmn:outgoing>Flow_U_iban_U_adr</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="U_adr" name="Adressen hybrid aufbauen (Ort und Land strukturiert)"><bpmn:incoming>Flow_U_iban_U_adr</bpmn:incoming><bpmn:outgoing>Flow_U_adr_U_gwOrt</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="U_gwOrt" name="Ort des Empfängers vorhanden?"><bpmn:incoming>Flow_U_adr_U_gwOrt</bpmn:incoming><bpmn:outgoing>Flow_U_gwOrt_U_endAxz</bpmn:outgoing><bpmn:outgoing>Flow_U_gwOrt_U_ort</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="U_ort" name="Ort im MC-Converter eintragen"><bpmn:incoming>Flow_U_gwOrt_U_ort</bpmn:incoming><bpmn:outgoing>Flow_U_ort_U_endAxz</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="U_endAxz" name="pain.001.001.09 AXZ erzeugt"><bpmn:incoming>Flow_U_gwOrt_U_endAxz</bpmn:incoming><bpmn:incoming>Flow_U_ort_U_endAxz</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_U_start_U_ns" sourceRef="U_start" targetRef="U_ns" />
      <bpmn:sequenceFlow id="Flow_U_ns_U_gw" sourceRef="U_ns" targetRef="U_gw" />
      <bpmn:sequenceFlow id="Flow_U_gw_U_struct" sourceRef="U_gw" targetRef="U_struct" name="SEPA" />
      <bpmn:sequenceFlow id="Flow_U_gw_U_read" sourceRef="U_gw" targetRef="U_read" name="DTAZV" />
      <bpmn:sequenceFlow id="Flow_U_gw_U_stop" sourceRef="U_gw" targetRef="U_stop" name="andere Datei" />
      <bpmn:sequenceFlow id="Flow_U_struct_U_strip" sourceRef="U_struct" targetRef="U_strip" />
      <bpmn:sequenceFlow id="Flow_U_strip_U_sum" sourceRef="U_strip" targetRef="U_sum" />
      <bpmn:sequenceFlow id="Flow_U_sum_U_clean" sourceRef="U_sum" targetRef="U_clean" />
      <bpmn:sequenceFlow id="Flow_U_clean_U_end" sourceRef="U_clean" targetRef="U_end" />
      <bpmn:sequenceFlow id="Flow_U_read_U_map" sourceRef="U_read" targetRef="U_map" />
      <bpmn:sequenceFlow id="Flow_U_map_U_iban" sourceRef="U_map" targetRef="U_iban" />
      <bpmn:sequenceFlow id="Flow_U_iban_U_adr" sourceRef="U_iban" targetRef="U_adr" />
      <bpmn:sequenceFlow id="Flow_U_adr_U_gwOrt" sourceRef="U_adr" targetRef="U_gwOrt" />
      <bpmn:sequenceFlow id="Flow_U_gwOrt_U_endAxz" sourceRef="U_gwOrt" targetRef="U_endAxz" name="ja" />
      <bpmn:sequenceFlow id="Flow_U_gwOrt_U_ort" sourceRef="U_gwOrt" targetRef="U_ort" name="nein" />
      <bpmn:sequenceFlow id="Flow_U_ort_U_endAxz" sourceRef="U_ort" targetRef="U_endAxz" />
      <bpmn:textAnnotation id="UN_ns"><bpmn:text>Erkennung am Inhalt, die Dateiendung spielt keine Rolle.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_UN_ns" associationDirection="None" sourceRef="U_ns" targetRef="UN_ns" />
      <bpmn:textAnnotation id="UN_struct"><bpmn:text>Im Reiter umschaltbar: Sammelbuchung, InstrId übernehmen, Zeichensatz.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_UN_struct" associationDirection="None" sourceRef="U_struct" targetRef="UN_struct" />
      <bpmn:textAnnotation id="UN_dtazv"><bpmn:text>DTAZV nehmen die Banken ab 14.11.2026 nicht mehr an. Einreichen per EBICS-Auftragsart AXZ.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_UN_dtazv" associationDirection="None" sourceRef="U_map" targetRef="UN_dtazv" />
      <bpmn:textAnnotation id="UN_ort"><bpmn:text>Ohne Ort lehnt die Bank die AXZ-Datei ab. Der Ort wird je Empfängerkonto gemerkt.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_UN_ort" associationDirection="None" sourceRef="U_ort" targetRef="UN_ort" />
  </bpmn:process>
