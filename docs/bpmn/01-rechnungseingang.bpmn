      <bpmn:sequenceFlow id="Flow_S_join_S_end" sourceRef="S_join" targetRef="S_end" />
      <bpmn:textAnnotation id="SN_lesbar"><bpmn:text>Entsteht bei XRechnung-XML und bei ZUGFeRD mit Formatmangel. Das Original bleibt immer erhalten.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_SN_lesbar" associationDirection="None" sourceRef="S_lesbar" targetRef="SN_lesbar" />
      <bpmn:textAnnotation id="SN_xml"><bpmn:text>Bei reiner XRechnung ist das Original schon die XML, darum keine zweite Datei.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_SN_xml" associationDirection="None" sourceRef="S_xml" targetRef="SN_xml" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="A_gwErr" name="Ergebnis rot oder falsches Werk?"><bpmn:incoming>Flow_C_side_A_gwErr</bpmn:incoming><bpmn:outgoing>Flow_A_gwErr_A_errMail</bpmn:outgoing><bpmn:outgoing>Flow_A_gwErr_A_archSend</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="A_errMail" name="Fehler-Mail an die Werks-Adresse"><bpmn:incoming>Flow_A_gwErr_A_errMail</bpmn:incoming><bpmn:outgoing>Flow_A_errMail_A_archSend</bpmn:outgoing></bpmn:sendTask>
      <bpmn:sendTask id="A_archSend" name="Archiv-Mail mit lesbarem PDF an das eigene Postfach senden"><bpmn:incoming>Flow_A_gwErr_A_archSend</bpmn:incoming><bpmn:incoming>Flow_A_errMail_A_archSend</bpmn:incoming><bpmn:outgoing>Flow_A_archSend_A_moveOrig</bpmn:outgoing></bpmn:sendTask>
      <bpmn:serviceTask id="A_moveOrig" name="Original-Mail nach „Verarbeitet“ verschieben"><bpmn:incoming>Flow_A_archSend_A_moveOrig</bpmn:incoming><bpmn:outgoing>Flow_A_moveOrig_D_gw</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="D_gw" name="Buchungsweg laut Prüfergebnis?"><bpmn:incoming>Flow_A_moveOrig_D_gw</bpmn:incoming><bpmn:outgoing>Flow_D_gw_D_book</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_4eyes</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_vorb</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_rej</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:manualTask id="D_book" name="Aus der XML im ERP erfassen und buchen"><bpmn:incoming>Flow_D_gw_D_book</bpmn:incoming><bpmn:incoming>Flow_D_4eyes_D_book</bpmn:incoming><bpmn:outgoing>Flow_D_book_D_gwRf</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="D_4eyes" name="Vier-Augen-Prüfung (Reverse-Charge, innergem., steuerfrei)"><bpmn:incoming>Flow_D_gw_D_4eyes</bpmn:incoming><bpmn:outgoing>Flow_D_4eyes_D_book</bpmn:outgoing></bpmn:userTask>
      <bpmn:manualTask id="D_vorb" name="Unter Vorbehalt buchen (sonstige Rechnung)"><bpmn:incoming>Flow_D_gw_D_vorb</bpmn:incoming><bpmn:outgoing>Flow_D_vorb_D_join</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="D_rej" name="Nicht buchen, Zurückweisung vorbereiten"><bpmn:incoming>Flow_D_gw_D_rej</bpmn:incoming><bpmn:outgoing>Flow_D_rej_D_join</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="D_gwRf" name="Rückfrage-Flag gesetzt?"><bpmn:incoming>Flow_D_book_D_gwRf</bpmn:incoming><bpmn:outgoing>Flow_D_gwRf_E_ok</bpmn:outgoing><bpmn:outgoing>Flow_D_gwRf_D_join</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="D_join"><bpmn:incoming>Flow_D_gwRf_D_join</bpmn:incoming><bpmn:incoming>Flow_D_vorb_D_join</bpmn:incoming><bpmn:incoming>Flow_D_rej_D_join</bpmn:incoming><bpmn:outgoing>Flow_D_join_D_kred</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="D_kred" name="Kreditor-Mail an den Lieferanten (Text aus „Kreditor-Aktion“)"><bpmn:incoming>Flow_D_join_D_kred</bpmn:incoming><bpmn:outgoing>Flow_D_kred_E_kred</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="E_ok" name="gebucht"><bpmn:incoming>Flow_D_gwRf_E_ok</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="E_kred" name="Lieferant informiert"><bpmn:incoming>Flow_D_kred_E_kred</bpmn:incoming></bpmn:endEvent>
