<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Eingang" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="1.0">
  <bpmn:category id="Cat_G_anhang"><bpmn:categoryValue id="CV_G_anhang" value="wiederholt sich je Anhang (PDF oder XML)" /></bpmn:category>
  <bpmn:collaboration id="Collab_Eingang">
    <bpmn:participant id="P_Lief" name="Lieferant" processRef="Proc_P_Lief" />
    <bpmn:participant id="P_Ein" name="DIHAG · Rechnungseingang (je Werk)" processRef="Proc_P_Ein" />
    <bpmn:messageFlow id="Msg_L_send_A_start" name="Rechnung (PDF oder XML)" sourceRef="L_send" targetRef="A_start" />
    <bpmn:messageFlow id="Msg_D_kred_P_Lief" name="Berichtigung, Rückfrage oder Zurückweisung" sourceRef="D_kred" targetRef="P_Lief" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_Lief" name="Lieferant" isExecutable="false">
      <bpmn:startEvent id="L_start" name="Rechnung ist fertig"><bpmn:outgoing>Flow_L_start_L_send</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sendTask id="L_send" name="Rechnung per E-Mail an das Werks-Postfach senden"><bpmn:incoming>Flow_L_start_L_send</bpmn:incoming><bpmn:outgoing>Flow_L_send_L_end</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="L_end" name="Rechnung versendet"><bpmn:incoming>Flow_L_send_L_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_L_start_L_send" sourceRef="L_start" targetRef="L_send" />
      <bpmn:sequenceFlow id="Flow_L_send_L_end" sourceRef="L_send" targetRef="L_end" />
  </bpmn:process>
  <bpmn:process id="Proc_P_Ein" name="DIHAG · Rechnungseingang (je Werk)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_Ein">
      <bpmn:lane id="LA" name="Werks-Postfach &amp; Power Automate"><bpmn:flowNodeRef>A_start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>A_move</bpmn:flowNodeRef><bpmn:flowNodeRef>A_endArch</bpmn:flowNodeRef><bpmn:flowNodeRef>A_att</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gwErr</bpmn:flowNodeRef><bpmn:flowNodeRef>A_errMail</bpmn:flowNodeRef><bpmn:flowNodeRef>A_archSend</bpmn:flowNodeRef><bpmn:flowNodeRef>A_moveOrig</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LB" name="Prüfdienst (Azure)"><bpmn:flowNodeRef>B_intake</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LC" name="SharePoint &amp; Monitoring"><bpmn:flowNodeRef>C_orig</bpmn:flowNodeRef><bpmn:flowNodeRef>C_meta</bpmn:flowNodeRef><bpmn:flowNodeRef>C_side</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LD" name="Kreditorenbuchhaltung"><bpmn:flowNodeRef>D_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>D_book</bpmn:flowNodeRef><bpmn:flowNodeRef>D_4eyes</bpmn:flowNodeRef><bpmn:flowNodeRef>D_vorb</bpmn:flowNodeRef><bpmn:flowNodeRef>D_rej</bpmn:flowNodeRef><bpmn:flowNodeRef>D_gwRf</bpmn:flowNodeRef><bpmn:flowNodeRef>D_join</bpmn:flowNodeRef><bpmn:flowNodeRef>D_kred</bpmn:flowNodeRef><bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>E_kred</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="A_start" name="Neue Mail mit Anhang im Werks-Postfach"><bpmn:outgoing>Flow_A_start_A_gw</bpmn:outgoing><bpmn:messageEventDefinition id="A_start_def" /></bpmn:startEvent>
      <bpmn:exclusiveGateway id="A_gw" name="Vom eigenen Postfach gesendet (Archiv-Mail)?"><bpmn:incoming>Flow_A_start_A_gw</bpmn:incoming><bpmn:outgoing>Flow_A_gw_A_move</bpmn:outgoing><bpmn:outgoing>Flow_A_gw_A_att</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_move" name="Archiv-Mail in den Unterordner „Verarbeitet“ verschieben"><bpmn:incoming>Flow_A_gw_A_move</bpmn:incoming><bpmn:outgoing>Flow_A_move_A_endArch</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="A_endArch" name="archiviert"><bpmn:incoming>Flow_A_move_A_endArch</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="A_att" name="Anhänge filtern: nur PDF und XML"><bpmn:incoming>Flow_A_gw_A_att</bpmn:incoming><bpmn:outgoing>Flow_A_att_B_intake</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:subProcess id="B_intake" name="Eingangsprüfung (/api/intake)"><bpmn:incoming>Flow_A_att_B_intake</bpmn:incoming><bpmn:outgoing>Flow_B_intake_C_orig</bpmn:outgoing>
      <bpmn:startEvent id="I_start" name="Anhang vom Flow"><bpmn:outgoing>Flow_I_start_I_norm</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="I_norm" name="Inhalt erkennen: PDF, XML, base64 oder Flow-Hülle"><bpmn:incoming>Flow_I_start_I_norm</bpmn:incoming><bpmn:outgoing>Flow_I_norm_I_gwTyp</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwTyp" name="PDF oder XML?"><bpmn:incoming>Flow_I_norm_I_gwTyp</bpmn:incoming><bpmn:outgoing>Flow_I_gwTyp_I_pdfa</bpmn:outgoing><bpmn:outgoing>Flow_I_gwTyp_I_xr</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_pdfa" name="veraPDF prüft die PDF/A-Hülle"><bpmn:incoming>Flow_I_gwTyp_I_pdfa</bpmn:incoming><bpmn:outgoing>Flow_I_pdfa_I_extract</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_extract" name="Eingebettete XML suchen"><bpmn:incoming>Flow_I_pdfa_I_extract</bpmn:incoming><bpmn:outgoing>Flow_I_extract_I_gwEinv</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwEinv" name="Echte E-Rechnung (CII oder UBL) eingebettet?"><bpmn:incoming>Flow_I_extract_I_gwEinv</bpmn:incoming><bpmn:outgoing>Flow_I_gwEinv_I_zf</bpmn:outgoing><bpmn:outgoing>Flow_I_gwEinv_I_sonst</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_sonst" name="Sonstige Rechnung: unter Vorbehalt, Berichtigung anfordern"><bpmn:incoming>Flow_I_gwEinv_I_sonst</bpmn:incoming><bpmn:outgoing>Flow_I_sonst_I_endSonst</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="I_endSonst" name="Ergebnis: sonstige Rechnung"><bpmn:incoming>Flow_I_sonst_I_endSonst</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="I_zf" name="Typ: ZUGFeRD"><bpmn:incoming>Flow_I_gwEinv_I_zf</bpmn:incoming><bpmn:outgoing>Flow_I_zf_I_mustang</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_mustang" name="Mustang prüft das tatsächliche Profil (mit Prüfbericht)"><bpmn:incoming>Flow_I_zf_I_mustang</bpmn:incoming><bpmn:outgoing>Flow_I_mustang_I_gwMin</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwMin" name="Profil MINIMUM oder BASIC-WL?"><bpmn:incoming>Flow_I_mustang_I_gwMin</bpmn:incoming><bpmn:outgoing>Flow_I_gwMin_I_rej</bpmn:outgoing><bpmn:outgoing>Flow_I_gwMin_I_gwPdfa</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_rej" name="Harter Stopp: keine E-Rechnung, Zurückweisung"><bpmn:incoming>Flow_I_gwMin_I_rej</bpmn:incoming><bpmn:outgoing>Flow_I_rej_I_endRej</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="I_endRej" name="Ergebnis: zurückgewiesen"><bpmn:incoming>Flow_I_rej_I_endRej</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="I_gwPdfa" name="PDF/A-3 in Ordnung?"><bpmn:incoming>Flow_I_gwMin_I_gwPdfa</bpmn:incoming><bpmn:outgoing>Flow_I_gwPdfa_I_join1</bpmn:outgoing><bpmn:outgoing>Flow_I_gwPdfa_I_fm</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_fm" name="Formatmangel: unter Vorbehalt, Berichtigung anfordern"><bpmn:incoming>Flow_I_gwPdfa_I_fm</bpmn:incoming><bpmn:outgoing>Flow_I_fm_I_join1</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_join1"><bpmn:incoming>Flow_I_gwPdfa_I_join1</bpmn:incoming><bpmn:incoming>Flow_I_fm_I_join1</bpmn:incoming><bpmn:incoming>Flow_I_kosit_I_join1</bpmn:incoming><bpmn:outgoing>Flow_I_join1_I_linkOut</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_xr" name="Typ: XRechnung (reine XML)"><bpmn:incoming>Flow_I_gwTyp_I_xr</bpmn:incoming><bpmn:outgoing>Flow_I_xr_I_kosit</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_kosit" name="KoSIT prüft XRechnung / EN 16931 (mit Prüfbericht)"><bpmn:incoming>Flow_I_xr_I_kosit</bpmn:incoming><bpmn:outgoing>Flow_I_kosit_I_join1</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="I_linkOut" name="weiter: Regelwerk"><bpmn:incoming>Flow_I_join1_I_linkOut</bpmn:incoming><bpmn:linkEventDefinition id="I_linkOut_def" name="Regelwerk" /></bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="I_linkIn" name="weiter: Regelwerk"><bpmn:outgoing>Flow_I_linkIn_I_daten</bpmn:outgoing><bpmn:linkEventDefinition id="I_linkIn_def" name="Regelwerk" /></bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="I_daten" name="Kopfdaten lesen: Nummer, Datum, Beträge, Steuerkategorie"><bpmn:incoming>Flow_I_linkIn_I_daten</bpmn:incoming><bpmn:outgoing>Flow_I_daten_I_werk</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_werk" name="Richtung und Werk bestimmen, Empfänger-Gegenprobe"><bpmn:incoming>Flow_I_daten_I_werk</bpmn:incoming><bpmn:outgoing>Flow_I_werk_I_gwSt</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwSt" name="Steuerkategorie AE, K, G, E oder O?"><bpmn:incoming>Flow_I_werk_I_gwSt</bpmn:incoming><bpmn:outgoing>Flow_I_gwSt_I_man</bpmn:outgoing><bpmn:outgoing>Flow_I_gwSt_I_join2</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_man" name="Manuelle Prüfung nötig (Vier-Augen), Buchung „manuell“"><bpmn:incoming>Flow_I_gwSt_I_man</bpmn:incoming><bpmn:outgoing>Flow_I_man_I_join2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_join2"><bpmn:incoming>Flow_I_gwSt_I_join2</bpmn:incoming><bpmn:incoming>Flow_I_man_I_join2</bpmn:incoming><bpmn:outgoing>Flow_I_join2_I_gwZf</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="I_gwZf" name="Quelle ZUGFeRD?"><bpmn:incoming>Flow_I_join2_I_gwZf</bpmn:incoming><bpmn:outgoing>Flow_I_gwZf_I_abgl</bpmn:outgoing><bpmn:outgoing>Flow_I_gwZf_I_join3</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_abgl" name="PDF und XML abgleichen: Nummer, Steuer, Brutto (rundungstolerant)"><bpmn:incoming>Flow_I_gwZf_I_abgl</bpmn:incoming><bpmn:outgoing>Flow_I_abgl_I_gwMat</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwMat" name="Materielle Abweichung?"><bpmn:incoming>Flow_I_abgl_I_gwMat</bpmn:incoming><bpmn:outgoing>Flow_I_gwMat_I_rf</bpmn:outgoing><bpmn:outgoing>Flow_I_gwMat_I_join3</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_rf" name="Rückfrage beim Lieferanten, die XML bleibt maßgeblich"><bpmn:incoming>Flow_I_gwMat_I_rf</bpmn:incoming><bpmn:outgoing>Flow_I_rf_I_join3</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_join3"><bpmn:incoming>Flow_I_gwZf_I_join3</bpmn:incoming><bpmn:incoming>Flow_I_gwMat_I_join3</bpmn:incoming><bpmn:incoming>Flow_I_rf_I_join3</bpmn:incoming><bpmn:outgoing>Flow_I_join3_I_gwRend</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="I_gwRend" name="XRechnung-XML oder Formatmangel?"><bpmn:incoming>Flow_I_join3_I_gwRend</bpmn:incoming><bpmn:outgoing>Flow_I_gwRend_I_render</bpmn:outgoing><bpmn:outgoing>Flow_I_gwRend_I_join4</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_render" name="Lesbares PDF/A-3b aus der XML erzeugen"><bpmn:incoming>Flow_I_gwRend_I_render</bpmn:incoming><bpmn:outgoing>Flow_I_render_I_join4</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_join4"><bpmn:incoming>Flow_I_gwRend_I_join4</bpmn:incoming><bpmn:incoming>Flow_I_render_I_join4</bpmn:incoming><bpmn:outgoing>Flow_I_join4_I_end</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="I_end" name="Prüfergebnis an den Flow (JSON)"><bpmn:incoming>Flow_I_join4_I_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_I_start_I_norm" sourceRef="I_start" targetRef="I_norm" />
      <bpmn:sequenceFlow id="Flow_I_norm_I_gwTyp" sourceRef="I_norm" targetRef="I_gwTyp" />
      <bpmn:sequenceFlow id="Flow_I_gwTyp_I_pdfa" sourceRef="I_gwTyp" targetRef="I_pdfa" name="PDF" />
      <bpmn:sequenceFlow id="Flow_I_gwTyp_I_xr" sourceRef="I_gwTyp" targetRef="I_xr" name="XML" />
      <bpmn:sequenceFlow id="Flow_I_pdfa_I_extract" sourceRef="I_pdfa" targetRef="I_extract" />
      <bpmn:sequenceFlow id="Flow_I_extract_I_gwEinv" sourceRef="I_extract" targetRef="I_gwEinv" />
      <bpmn:sequenceFlow id="Flow_I_gwEinv_I_zf" sourceRef="I_gwEinv" targetRef="I_zf" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwEinv_I_sonst" sourceRef="I_gwEinv" targetRef="I_sonst" name="nein oder fremde XML" />
      <bpmn:sequenceFlow id="Flow_I_sonst_I_endSonst" sourceRef="I_sonst" targetRef="I_endSonst" />
      <bpmn:sequenceFlow id="Flow_I_zf_I_mustang" sourceRef="I_zf" targetRef="I_mustang" />
      <bpmn:sequenceFlow id="Flow_I_mustang_I_gwMin" sourceRef="I_mustang" targetRef="I_gwMin" />
      <bpmn:sequenceFlow id="Flow_I_gwMin_I_rej" sourceRef="I_gwMin" targetRef="I_rej" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_rej_I_endRej" sourceRef="I_rej" targetRef="I_endRej" />
      <bpmn:sequenceFlow id="Flow_I_gwMin_I_gwPdfa" sourceRef="I_gwMin" targetRef="I_gwPdfa" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_gwPdfa_I_join1" sourceRef="I_gwPdfa" targetRef="I_join1" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwPdfa_I_fm" sourceRef="I_gwPdfa" targetRef="I_fm" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_fm_I_join1" sourceRef="I_fm" targetRef="I_join1" />
      <bpmn:sequenceFlow id="Flow_I_xr_I_kosit" sourceRef="I_xr" targetRef="I_kosit" />
      <bpmn:sequenceFlow id="Flow_I_kosit_I_join1" sourceRef="I_kosit" targetRef="I_join1" />
      <bpmn:sequenceFlow id="Flow_I_join1_I_linkOut" sourceRef="I_join1" targetRef="I_linkOut" />
      <bpmn:sequenceFlow id="Flow_I_linkIn_I_daten" sourceRef="I_linkIn" targetRef="I_daten" />
      <bpmn:sequenceFlow id="Flow_I_daten_I_werk" sourceRef="I_daten" targetRef="I_werk" />
      <bpmn:sequenceFlow id="Flow_I_werk_I_gwSt" sourceRef="I_werk" targetRef="I_gwSt" />
      <bpmn:sequenceFlow id="Flow_I_gwSt_I_man" sourceRef="I_gwSt" targetRef="I_man" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwSt_I_join2" sourceRef="I_gwSt" targetRef="I_join2" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_man_I_join2" sourceRef="I_man" targetRef="I_join2" />
      <bpmn:sequenceFlow id="Flow_I_join2_I_gwZf" sourceRef="I_join2" targetRef="I_gwZf" />
      <bpmn:sequenceFlow id="Flow_I_gwZf_I_abgl" sourceRef="I_gwZf" targetRef="I_abgl" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwZf_I_join3" sourceRef="I_gwZf" targetRef="I_join3" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_abgl_I_gwMat" sourceRef="I_abgl" targetRef="I_gwMat" />
      <bpmn:sequenceFlow id="Flow_I_gwMat_I_rf" sourceRef="I_gwMat" targetRef="I_rf" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwMat_I_join3" sourceRef="I_gwMat" targetRef="I_join3" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_rf_I_join3" sourceRef="I_rf" targetRef="I_join3" />
      <bpmn:sequenceFlow id="Flow_I_join3_I_gwRend" sourceRef="I_join3" targetRef="I_gwRend" />
      <bpmn:sequenceFlow id="Flow_I_gwRend_I_render" sourceRef="I_gwRend" targetRef="I_render" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwRend_I_join4" sourceRef="I_gwRend" targetRef="I_join4" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_render_I_join4" sourceRef="I_render" targetRef="I_join4" />
      <bpmn:sequenceFlow id="Flow_I_join4_I_end" sourceRef="I_join4" targetRef="I_end" />
      <bpmn:textAnnotation id="IN_sonst"><bpmn:text>Auch fremde XML (z. B. openTRANS) zählt nicht als E-Rechnung. Übergang: sonstige Rechnungen sind bis 31.12.2026 zulässig, bei Vorjahresumsatz bis 800.000 € bis 31.12.2027.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_IN_sonst" associationDirection="None" sourceRef="I_sonst" targetRef="IN_sonst" />
      <bpmn:textAnnotation id="IN_kosit"><bpmn:text>Nur formale Verstöße (Leitweg-ID, elektronische Adresse) sind Hinweise und werten nicht ab.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_IN_kosit" associationDirection="None" sourceRef="I_kosit" targetRef="IN_kosit" />
      <bpmn:textAnnotation id="IN_werk"><bpmn:text>Ist eine DIHAG-Gesellschaft Verkäufer, gilt die Rechnung als Ausgang (Ablage in AR_&lt;Werk&gt;).</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_IN_werk" associationDirection="None" sourceRef="I_werk" targetRef="IN_werk" />
      </bpmn:subProcess>
      <bpmn:serviceTask id="C_orig" name="Original in ERAR_&lt;Werk&gt; ablegen (Name: Nummer_USt-IdNr)"><bpmn:incoming>Flow_B_intake_C_orig</bpmn:incoming><bpmn:outgoing>Flow_C_orig_C_meta</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="C_meta" name="Metadaten setzen: Typ, Konformität, Buchung, Prüf-Flags, Fälligkeit"><bpmn:incoming>Flow_C_orig_C_meta</bpmn:incoming><bpmn:outgoing>Flow_C_meta_C_side</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:subProcess id="C_side" name="Nebendateien ablegen"><bpmn:incoming>Flow_C_meta_C_side</bpmn:incoming><bpmn:outgoing>Flow_C_side_A_gwErr</bpmn:outgoing>
      <bpmn:startEvent id="S_start" name="Prüfergebnis liegt vor"><bpmn:outgoing>Flow_S_start_S_split</bpmn:outgoing></bpmn:startEvent>
      <bpmn:inclusiveGateway id="S_split" name="Was liegt vor?"><bpmn:incoming>Flow_S_start_S_split</bpmn:incoming><bpmn:outgoing>Flow_S_split_S_lesbar</bpmn:outgoing><bpmn:outgoing>Flow_S_split_S_kosit</bpmn:outgoing><bpmn:outgoing>Flow_S_split_S_xml</bpmn:outgoing></bpmn:inclusiveGateway>
      <bpmn:serviceTask id="S_lesbar" name="Lesbares PDF als _lesbar.pdf ablegen"><bpmn:incoming>Flow_S_split_S_lesbar</bpmn:incoming><bpmn:outgoing>Flow_S_lesbar_S_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="S_kosit" name="Prüfbericht als _KoSIT-Bericht.xml ablegen"><bpmn:incoming>Flow_S_split_S_kosit</bpmn:incoming><bpmn:outgoing>Flow_S_kosit_S_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="S_xml" name="XML separat ablegen"><bpmn:incoming>Flow_S_split_S_xml</bpmn:incoming><bpmn:outgoing>Flow_S_xml_S_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:inclusiveGateway id="S_join"><bpmn:incoming>Flow_S_lesbar_S_join</bpmn:incoming><bpmn:incoming>Flow_S_kosit_S_join</bpmn:incoming><bpmn:incoming>Flow_S_xml_S_join</bpmn:incoming><bpmn:outgoing>Flow_S_join_S_end</bpmn:outgoing></bpmn:inclusiveGateway>
      <bpmn:endEvent id="S_end" name="Nebendateien abgelegt"><bpmn:incoming>Flow_S_join_S_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S_start_S_split" sourceRef="S_start" targetRef="S_split" />
      <bpmn:sequenceFlow id="Flow_S_split_S_lesbar" sourceRef="S_split" targetRef="S_lesbar" name="lesbares PDF" />
      <bpmn:sequenceFlow id="Flow_S_split_S_kosit" sourceRef="S_split" targetRef="S_kosit" name="Prüfbericht" />
      <bpmn:sequenceFlow id="Flow_S_split_S_xml" sourceRef="S_split" targetRef="S_xml" name="nur ZUGFeRD" />
      <bpmn:sequenceFlow id="Flow_S_lesbar_S_join" sourceRef="S_lesbar" targetRef="S_join" />
      <bpmn:sequenceFlow id="Flow_S_kosit_S_join" sourceRef="S_kosit" targetRef="S_join" />
