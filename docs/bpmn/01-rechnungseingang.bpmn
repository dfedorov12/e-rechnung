      <bpmndi:BPMNShape id="D_vorb_di" bpmnElement="D_vorb" bioc:stroke="#A65F00" bioc:fill="#FFF1CC" color:background-color="#FFF1CC" color:border-color="#A65F00"><dc:Bounds x="2749" y="1128" width="132" height="84" /></bpmndi:BPMNShape>
