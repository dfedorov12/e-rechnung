<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_eingang" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:category id="Cat_G_anhang"><bpmn:categoryValue id="CV_G_anhang" value="wiederholt sich je Anhang (PDF oder XML)" /></bpmn:category>
  <bpmn:collaboration id="Collab_eingang">
    <bpmn:participant id="P_Lief" name="Lieferant" />
    <bpmn:participant id="P_Ein" name="DIHAG · Rechnungseingang (je Werk)" processRef="Process_ERechnung_Eingang" />
    <bpmn:messageFlow id="Msg_P_Lief_A_start" name="Rechnung (PDF oder XML)" sourceRef="P_Lief" targetRef="A_start" />
    <bpmn:messageFlow id="Msg_D_kred_P_Lief" name="Berichtigung, Rückfrage oder Zurückweisung" sourceRef="D_kred" targetRef="P_Lief" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ERechnung_Eingang" name="E-Rechnung Rechnungseingang" isExecutable="false">
    <bpmn:documentation>Eingangsrechnungen kommen per Mail ins Werks-Postfach. Power Automate gibt jeden PDF- oder XML-Anhang an den Prüfdienst, legt Original und Prüfergebnis in ERAR_&lt;Werk&gt; ab und schlägt der Kreditorenbuchhaltung den Buchungsweg vor.
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#eingang
Im Einklang mit den Richtlinien: ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Ein">
      <bpmn:lane id="LA" name="Werks-Postfach &amp; Power Automate"><bpmn:flowNodeRef>A_start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>A_move</bpmn:flowNodeRef><bpmn:flowNodeRef>A_endArch</bpmn:flowNodeRef><bpmn:flowNodeRef>A_att</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gwErr</bpmn:flowNodeRef><bpmn:flowNodeRef>A_errMail</bpmn:flowNodeRef><bpmn:flowNodeRef>A_archSend</bpmn:flowNodeRef><bpmn:flowNodeRef>A_moveOrig</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LB" name="Prüfdienst (Azure)"><bpmn:flowNodeRef>B_intake</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LC" name="SharePoint &amp; Monitoring"><bpmn:flowNodeRef>C_orig</bpmn:flowNodeRef><bpmn:flowNodeRef>C_meta</bpmn:flowNodeRef><bpmn:flowNodeRef>C_side</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LD" name="Kreditorenbuchhaltung"><bpmn:flowNodeRef>D_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>D_book</bpmn:flowNodeRef><bpmn:flowNodeRef>D_4eyes</bpmn:flowNodeRef><bpmn:flowNodeRef>D_vorb</bpmn:flowNodeRef><bpmn:flowNodeRef>D_rej</bpmn:flowNodeRef><bpmn:flowNodeRef>D_gwRf</bpmn:flowNodeRef><bpmn:flowNodeRef>D_kred</bpmn:flowNodeRef><bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>E_kred</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="A_start" name="Neue Mail mit Anhang im Werks-Postfach"><bpmn:outgoing>Flow_A_start_A_gw</bpmn:outgoing><bpmn:messageEventDefinition id="A_start_def" /></bpmn:startEvent>
      <bpmn:exclusiveGateway id="A_gw" name="Vom eigenen Postfach gesendet (Archiv-Mail)?"><bpmn:incoming>Flow_A_start_A_gw</bpmn:incoming><bpmn:outgoing>Flow_A_gw_A_move</bpmn:outgoing><bpmn:outgoing>Flow_A_gw_A_att</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_move" name="Archiv-Mail in den Unterordner „Verarbeitet“ verschieben"><bpmn:incoming>Flow_A_gw_A_move</bpmn:incoming><bpmn:outgoing>Flow_A_move_A_endArch</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="A_endArch" name="archiviert"><bpmn:incoming>Flow_A_move_A_endArch</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="A_att" name="Nur PDF- und XML-Anhänge weitergeben"><bpmn:incoming>Flow_A_gw_A_att</bpmn:incoming><bpmn:outgoing>Flow_A_att_B_intake</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:callActivity id="B_intake" name="Eingangsprüfung (/api/intake)" calledElement="Process_ERechnung_Eingangspruefung"><bpmn:documentation>Unterprozess: E-Rechnung Eingangsprüfung
[[rms:modell=01NH6NP5HCSYDEL23CFRHJT7LB7QUEENHF]]</bpmn:documentation><bpmn:incoming>Flow_A_att_B_intake</bpmn:incoming><bpmn:outgoing>Flow_B_intake_C_orig</bpmn:outgoing></bpmn:callActivity>
      <bpmn:serviceTask id="C_orig" name="Original in ERAR_&lt;Werk&gt; ablegen (Name: Nummer_USt-IdNr)"><bpmn:incoming>Flow_B_intake_C_orig</bpmn:incoming><bpmn:outgoing>Flow_C_orig_C_meta</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="C_meta" name="Metadaten setzen (Typ, Konformität, Buchung, Prüf-Flags, Fälligkeit)"><bpmn:incoming>Flow_C_orig_C_meta</bpmn:incoming><bpmn:outgoing>Flow_C_meta_C_side</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:callActivity id="C_side" name="Nebendateien ablegen" calledElement="Process_ERechnung_Nebendateien"><bpmn:documentation>Unterprozess: E-Rechnung Nebendateien ablegen
[[rms:modell=01NH6NP5G7V3KZMFQIXJF23PZ25WTOJAXE]]</bpmn:documentation><bpmn:incoming>Flow_C_meta_C_side</bpmn:incoming><bpmn:outgoing>Flow_C_side_A_gwErr</bpmn:outgoing></bpmn:callActivity>
      <bpmn:exclusiveGateway id="A_gwErr" name="Ergebnis rot oder falsches Werk?"><bpmn:incoming>Flow_C_side_A_gwErr</bpmn:incoming><bpmn:outgoing>Flow_A_gwErr_A_errMail</bpmn:outgoing><bpmn:outgoing>Flow_A_gwErr_A_archSend</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_errMail" name="Fehler-Mail an die Werks-Adresse senden"><bpmn:incoming>Flow_A_gwErr_A_errMail</bpmn:incoming><bpmn:outgoing>Flow_A_errMail_A_archSend</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="A_archSend" name="Archiv-Mail mit lesbarem PDF an das eigene Postfach senden"><bpmn:incoming>Flow_A_gwErr_A_archSend</bpmn:incoming><bpmn:incoming>Flow_A_errMail_A_archSend</bpmn:incoming><bpmn:outgoing>Flow_A_archSend_A_moveOrig</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="A_moveOrig" name="Original-Mail nach „Verarbeitet“ verschieben"><bpmn:incoming>Flow_A_archSend_A_moveOrig</bpmn:incoming><bpmn:outgoing>Flow_A_moveOrig_D_gw</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="D_gw" name="Buchungsweg laut Prüfergebnis?"><bpmn:incoming>Flow_A_moveOrig_D_gw</bpmn:incoming><bpmn:outgoing>Flow_D_gw_D_book</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_4eyes</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_vorb</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_rej</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:manualTask id="D_book" name="Aus der XML im ERP erfassen und buchen"><bpmn:incoming>Flow_D_gw_D_book</bpmn:incoming><bpmn:incoming>Flow_D_4eyes_D_book</bpmn:incoming><bpmn:outgoing>Flow_D_book_D_gwRf</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="D_4eyes" name="Im Vier-Augen-Prinzip prüfen (Reverse-Charge, innergem., steuerfrei)"><bpmn:incoming>Flow_D_gw_D_4eyes</bpmn:incoming><bpmn:outgoing>Flow_D_4eyes_D_book</bpmn:outgoing></bpmn:userTask>
      <bpmn:manualTask id="D_vorb" name="Unter Vorbehalt buchen (sonstige Rechnung)"><bpmn:incoming>Flow_D_gw_D_vorb</bpmn:incoming><bpmn:outgoing>Flow_D_vorb_D_kred</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="D_rej" name="Nicht buchen, Zurückweisung vorbereiten"><bpmn:incoming>Flow_D_gw_D_rej</bpmn:incoming><bpmn:outgoing>Flow_D_rej_D_kred</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="D_gwRf" name="Rückfrage-Flag gesetzt?"><bpmn:incoming>Flow_D_book_D_gwRf</bpmn:incoming><bpmn:outgoing>Flow_D_gwRf_E_ok</bpmn:outgoing><bpmn:outgoing>Flow_D_gwRf_D_kred</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="D_kred" name="Kreditor-Mail an den Lieferanten senden (Text aus „Kreditor-Aktion“)"><bpmn:incoming>Flow_D_gwRf_D_kred</bpmn:incoming><bpmn:incoming>Flow_D_vorb_D_kred</bpmn:incoming><bpmn:incoming>Flow_D_rej_D_kred</bpmn:incoming><bpmn:outgoing>Flow_D_kred_E_kred</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="E_ok" name="gebucht"><bpmn:incoming>Flow_D_gwRf_E_ok</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="E_kred" name="Lieferant informiert"><bpmn:incoming>Flow_D_kred_E_kred</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_start_A_gw" sourceRef="A_start" targetRef="A_gw" />
      <bpmn:sequenceFlow id="Flow_A_gw_A_move" sourceRef="A_gw" targetRef="A_move" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_move_A_endArch" sourceRef="A_move" targetRef="A_endArch" />
      <bpmn:sequenceFlow id="Flow_A_gw_A_att" sourceRef="A_gw" targetRef="A_att" name="nein" />
      <bpmn:sequenceFlow id="Flow_A_att_B_intake" sourceRef="A_att" targetRef="B_intake" />
      <bpmn:sequenceFlow id="Flow_B_intake_C_orig" sourceRef="B_intake" targetRef="C_orig" />
      <bpmn:sequenceFlow id="Flow_C_orig_C_meta" sourceRef="C_orig" targetRef="C_meta" />
      <bpmn:sequenceFlow id="Flow_C_meta_C_side" sourceRef="C_meta" targetRef="C_side" />
      <bpmn:sequenceFlow id="Flow_C_side_A_gwErr" sourceRef="C_side" targetRef="A_gwErr" />
      <bpmn:sequenceFlow id="Flow_A_gwErr_A_errMail" sourceRef="A_gwErr" targetRef="A_errMail" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_gwErr_A_archSend" sourceRef="A_gwErr" targetRef="A_archSend" name="nein" />
      <bpmn:sequenceFlow id="Flow_A_errMail_A_archSend" sourceRef="A_errMail" targetRef="A_archSend" />
      <bpmn:sequenceFlow id="Flow_A_archSend_A_moveOrig" sourceRef="A_archSend" targetRef="A_moveOrig" />
      <bpmn:sequenceFlow id="Flow_A_moveOrig_D_gw" sourceRef="A_moveOrig" targetRef="D_gw" />
      <bpmn:sequenceFlow id="Flow_D_gw_D_book" sourceRef="D_gw" targetRef="D_book" name="Automatik" />
      <bpmn:sequenceFlow id="Flow_D_gw_D_4eyes" sourceRef="D_gw" targetRef="D_4eyes" name="manuell" />
      <bpmn:sequenceFlow id="Flow_D_gw_D_vorb" sourceRef="D_gw" targetRef="D_vorb" name="unter Vorbehalt" />
      <bpmn:sequenceFlow id="Flow_D_gw_D_rej" sourceRef="D_gw" targetRef="D_rej" name="zurückgewiesen" />
      <bpmn:sequenceFlow id="Flow_D_4eyes_D_book" sourceRef="D_4eyes" targetRef="D_book" name="freigegeben" />
      <bpmn:sequenceFlow id="Flow_D_book_D_gwRf" sourceRef="D_book" targetRef="D_gwRf" />
      <bpmn:sequenceFlow id="Flow_D_gwRf_E_ok" sourceRef="D_gwRf" targetRef="E_ok" name="nein" />
      <bpmn:sequenceFlow id="Flow_D_gwRf_D_kred" sourceRef="D_gwRf" targetRef="D_kred" name="ja: Rückfrage" />
      <bpmn:sequenceFlow id="Flow_D_vorb_D_kred" sourceRef="D_vorb" targetRef="D_kred" name="Berichtigung" />
      <bpmn:sequenceFlow id="Flow_D_rej_D_kred" sourceRef="D_rej" targetRef="D_kred" name="Zurückweisung" />
      <bpmn:sequenceFlow id="Flow_D_kred_E_kred" sourceRef="D_kred" targetRef="E_kred" />
      <bpmn:textAnnotation id="N_arch"><bpmn:text>Schleifenschutz: Die Archiv-Mail mit dem lesbaren PDF kommt selbst wieder hier an. Absender ist das eigene Postfach, darum wird sie nur einsortiert.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_arch" associationDirection="None" sourceRef="A_move" targetRef="N_arch" />
      <bpmn:textAnnotation id="N_err"><bpmn:text>Eigener Flow „Fehler melden“. Die Adresse je Werk steht unter Einstellungen.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_err" associationDirection="None" sourceRef="A_errMail" targetRef="N_err" />
      <bpmn:textAnnotation id="N_kred"><bpmn:text>Automatischer Versand ist geplant. Bis dahin schickt die Buchhaltung die Mail selbst.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_kred" associationDirection="None" sourceRef="D_kred" targetRef="N_kred" />
      <bpmn:group id="G_anhang" categoryValueRef="CV_G_anhang" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_eingang">
    <bpmndi:BPMNPlane id="Plane_eingang" bpmnElement="Collab_eingang">
      <bpmndi:BPMNShape id="P_Lief_di" bpmnElement="P_Lief" isHorizontal="true" bioc:stroke="#5B6472" bioc:fill="#F6F7F9" color:background-color="#F6F7F9" color:border-color="#5B6472"><dc:Bounds x="100" y="60" width="3340" height="70" /></bpmndi:BPMNShape>
