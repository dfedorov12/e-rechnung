      <bpmndi:BPMNShape id="P_gw_di" bpmnElement="P_gw" isMarkerVisible="true" bioc:stroke="#8A6100" bioc:fill="#FFF8DB" color:background-color="#FFF8DB" color:border-color="#8A6100"><dc:Bounds x="1260" y="345" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1185" y="326" width="96" height="15" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
