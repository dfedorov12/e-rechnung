      <bpmndi:BPMNShape id="P_txt_di" bpmnElement="P_txt" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="539" y="448" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_date_di" bpmnElement="P_date" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="539" y="568" width="132" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_join_di" bpmnElement="P_join" isMarkerVisible="true" bioc:stroke="#8A6100" bioc:fill="#FFF8DB" color:background-color="#FFF8DB" color:border-color="#8A6100"><dc:Bounds x="750" y="345" width="50" height="50" /></bpmndi:BPMNShape>
