      <bpmndi:BPMNEdge id="Flow_P_split_P_sum_di" bpmnElement="Flow_P_split_P_sum"><di:waypoint x="460" y="370" /><di:waypoint x="539" y="370" /></bpmndi:BPMNEdge>
