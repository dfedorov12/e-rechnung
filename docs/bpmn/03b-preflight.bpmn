      <bpmndi:BPMNShape id="P_red_di" bpmnElement="P_red" bioc:stroke="#B42318" bioc:fill="#FDE2E1" color:background-color="#FDE2E1" color:border-color="#B42318"><dc:Bounds x="1437" y="472" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1395" y="513" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
