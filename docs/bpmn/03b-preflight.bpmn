      <bpmndi:BPMNShape id="P_iban_di" bpmnElement="P_iban" bioc:stroke="#1A2644" bioc:fill="#DCE5F2" color:background-color="#DCE5F2" color:border-color="#1A2644"><dc:Bounds x="539" y="88" width="132" height="84" /></bpmndi:BPMNShape>
