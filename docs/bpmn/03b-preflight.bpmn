      <bpmndi:BPMNEdge id="Flow_P_iban_P_join_di" bpmnElement="Flow_P_iban_P_join"><di:waypoint x="671" y="130" /><di:waypoint x="775" y="130" /><di:waypoint x="775" y="345" /></bpmndi:BPMNEdge>
