<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_preflight" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_preflight">
    <bpmn:participant id="P_Pre" name="Preflight" processRef="Process_Zahldatei_Preflight" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Zahldatei_Preflight" name="Zahldatei-Preflight" isExecutable="false">
    <bpmn:documentation>Der Preflight prüft die fertige pain.001.001.09 auf die Gründe, an denen Banken ablehnen. Bei Auslandszahlungen (AXZ) kommen die Pflichtfelder der DK dazu.
Eingebunden in: Zahlungsausgang (MC-Converter).
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#zahlung
Im Einklang mit den Richtlinien: ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Pre">
      <bpmn:lane id="LP" name="MC-Converter (Browser-App)"><bpmn:flowNodeRef>P_start</bpmn:flowNodeRef><bpmn:flowNodeRef>P_split</bpmn:flowNodeRef><bpmn:flowNodeRef>P_iban</bpmn:flowNodeRef><bpmn:flowNodeRef>P_bic</bpmn:flowNodeRef><bpmn:flowNodeRef>P_sum</bpmn:flowNodeRef><bpmn:flowNodeRef>P_txt</bpmn:flowNodeRef><bpmn:flowNodeRef>P_date</bpmn:flowNodeRef><bpmn:flowNodeRef>P_join</bpmn:flowNodeRef><bpmn:flowNodeRef>P_gwAxz</bpmn:flowNodeRef><bpmn:flowNodeRef>P_axz</bpmn:flowNodeRef><bpmn:flowNodeRef>P_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>P_green</bpmn:flowNodeRef><bpmn:flowNodeRef>P_red</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="P_start" name="umgestellte Datei"><bpmn:outgoing>Flow_P_start_P_split</bpmn:outgoing></bpmn:startEvent>
      <bpmn:parallelGateway id="P_split"><bpmn:incoming>Flow_P_start_P_split</bpmn:incoming><bpmn:outgoing>Flow_P_split_P_iban</bpmn:outgoing><bpmn:outgoing>Flow_P_split_P_bic</bpmn:outgoing><bpmn:outgoing>Flow_P_split_P_sum</bpmn:outgoing><bpmn:outgoing>Flow_P_split_P_txt</bpmn:outgoing><bpmn:outgoing>Flow_P_split_P_date</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:serviceTask id="P_iban" name="IBAN-Prüfziffer (Mod-97) je Konto prüfen"><bpmn:incoming>Flow_P_split_P_iban</bpmn:incoming><bpmn:outgoing>Flow_P_iban_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="P_bic" name="BIC-Format prüfen"><bpmn:incoming>Flow_P_split_P_bic</bpmn:incoming><bpmn:outgoing>Flow_P_bic_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="P_sum" name="Anzahl und Kontrollsumme gegen die Posten prüfen"><bpmn:incoming>Flow_P_split_P_sum</bpmn:incoming><bpmn:outgoing>Flow_P_sum_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="P_txt" name="Zeichensatz und Feldlängen prüfen (SEPA bzw. SWIFT)"><bpmn:incoming>Flow_P_split_P_txt</bpmn:incoming><bpmn:outgoing>Flow_P_txt_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="P_date" name="Ausführungsdatum prüfen"><bpmn:incoming>Flow_P_split_P_date</bpmn:incoming><bpmn:outgoing>Flow_P_date_P_join</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:parallelGateway id="P_join"><bpmn:incoming>Flow_P_iban_P_join</bpmn:incoming><bpmn:incoming>Flow_P_bic_P_join</bpmn:incoming><bpmn:incoming>Flow_P_sum_P_join</bpmn:incoming><bpmn:incoming>Flow_P_txt_P_join</bpmn:incoming><bpmn:incoming>Flow_P_date_P_join</bpmn:incoming><bpmn:outgoing>Flow_P_join_P_gwAxz</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:exclusiveGateway id="P_gwAxz" name="Auslandszahlung (AXZ)?"><bpmn:incoming>Flow_P_join_P_gwAxz</bpmn:incoming><bpmn:outgoing>Flow_P_gwAxz_P_gw</bpmn:outgoing><bpmn:outgoing>Flow_P_gwAxz_P_axz</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P_axz" name="AXZ-Pflichtfelder prüfen (Ort und Land, Entgelt, Service-Level, Währungsstellen)"><bpmn:incoming>Flow_P_gwAxz_P_axz</bpmn:incoming><bpmn:outgoing>Flow_P_axz_P_gw</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_gw" name="Fehler gefunden?"><bpmn:incoming>Flow_P_gwAxz_P_gw</bpmn:incoming><bpmn:incoming>Flow_P_axz_P_gw</bpmn:incoming><bpmn:outgoing>Flow_P_gw_P_green</bpmn:outgoing><bpmn:outgoing>Flow_P_gw_P_red</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="P_green" name="grün: bankfertig"><bpmn:incoming>Flow_P_gw_P_green</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="P_red" name="rot: nicht bankfertig"><bpmn:incoming>Flow_P_gw_P_red</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_P_start_P_split" sourceRef="P_start" targetRef="P_split" />
      <bpmn:sequenceFlow id="Flow_P_split_P_iban" sourceRef="P_split" targetRef="P_iban" />
      <bpmn:sequenceFlow id="Flow_P_split_P_bic" sourceRef="P_split" targetRef="P_bic" />
      <bpmn:sequenceFlow id="Flow_P_split_P_sum" sourceRef="P_split" targetRef="P_sum" />
      <bpmn:sequenceFlow id="Flow_P_split_P_txt" sourceRef="P_split" targetRef="P_txt" />
      <bpmn:sequenceFlow id="Flow_P_split_P_date" sourceRef="P_split" targetRef="P_date" />
      <bpmn:sequenceFlow id="Flow_P_iban_P_join" sourceRef="P_iban" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_bic_P_join" sourceRef="P_bic" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_sum_P_join" sourceRef="P_sum" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_txt_P_join" sourceRef="P_txt" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_date_P_join" sourceRef="P_date" targetRef="P_join" />
      <bpmn:sequenceFlow id="Flow_P_join_P_gwAxz" sourceRef="P_join" targetRef="P_gwAxz" />
      <bpmn:sequenceFlow id="Flow_P_gwAxz_P_gw" sourceRef="P_gwAxz" targetRef="P_gw" name="nein" />
      <bpmn:sequenceFlow id="Flow_P_gwAxz_P_axz" sourceRef="P_gwAxz" targetRef="P_axz" name="ja" />
      <bpmn:sequenceFlow id="Flow_P_axz_P_gw" sourceRef="P_axz" targetRef="P_gw" />
      <bpmn:sequenceFlow id="Flow_P_gw_P_green" sourceRef="P_gw" targetRef="P_green" name="nein" />
      <bpmn:sequenceFlow id="Flow_P_gw_P_red" sourceRef="P_gw" targetRef="P_red" name="ja" />
      <bpmn:textAnnotation id="PN_date"><bpmn:text>Ein Datum in der Vergangenheit ist nur ein Hinweis. Die Bank bucht am nächsten Bankarbeitstag.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_PN_date" associationDirection="None" sourceRef="P_date" targetRef="PN_date" />
      <bpmn:textAnnotation id="PN_axz"><bpmn:text>Über 50.000 € ins Ausland erinnert der Preflight an die AWV-Meldung an die Bundesbank.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_PN_axz" associationDirection="None" sourceRef="P_axz" targetRef="PN_axz" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_preflight">
    <bpmndi:BPMNPlane id="Plane_preflight" bpmnElement="Collab_preflight">
      <bpmndi:BPMNShape id="P_Pre_di" bpmnElement="P_Pre" isHorizontal="true" bioc:stroke="#1A2644" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" color:border-color="#1A2644"><dc:Bounds x="100" y="60" width="1470" height="740" /></bpmndi:BPMNShape>
