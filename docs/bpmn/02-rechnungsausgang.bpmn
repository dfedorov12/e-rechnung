<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_ausgang" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:error id="Error_Pruefung" name="Prüfung nicht bestanden" errorCode="PRUEFUNG" />
  <bpmn:collaboration id="Collab_ausgang">
    <bpmn:participant id="P_Kunde" name="Kunde" />
    <bpmn:participant id="P_Aus" name="DIHAG · Rechnungsausgang (je Werk)" processRef="Process_ERechnung_Ausgang" />
    <bpmn:messageFlow id="Msg_F_send_P_Kunde" name="E-Rechnung (ZUGFeRD oder XRechnung)" sourceRef="F_send" targetRef="P_Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ERechnung_Ausgang" name="E-Rechnung Rechnungsausgang" isExecutable="false">
    <bpmn:documentation>Ausgangsrechnungen der Werke ohne SAP entstehen im Konverter: PDF aus dem ERP laden, Daten prüfen, ZUGFeRD oder XRechnung erzeugen, in AR_&lt;Werk&gt; ablegen und an den Kunden senden. SAP-Werke laufen über EDIzone.
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#ausgang</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Aus">
      <bpmn:lane id="LV" name="Versand / Lager"><bpmn:flowNodeRef>V_start</bpmn:flowNodeRef><bpmn:flowNodeRef>V_wa</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LF" name="Vertrieb / Fakturierung"><bpmn:flowNodeRef>F_fakt</bpmn:flowNodeRef><bpmn:flowNodeRef>F_gwSap</bpmn:flowNodeRef><bpmn:flowNodeRef>F_edi</bpmn:flowNodeRef><bpmn:flowNodeRef>F_endEdi</bpmn:flowNodeRef><bpmn:flowNodeRef>F_send</bpmn:flowNodeRef><bpmn:flowNodeRef>F_end</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LK" name="Konverter (Browser-App)"><bpmn:flowNodeRef>K_upload</bpmn:flowNodeRef><bpmn:flowNodeRef>K_erk</bpmn:flowNodeRef><bpmn:flowNodeRef>K_exp</bpmn:flowNodeRef><bpmn:flowNodeRef>K_bErr</bpmn:flowNodeRef><bpmn:flowNodeRef>K_fix</bpmn:flowNodeRef><bpmn:flowNodeRef>K_mail</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LS" name="SharePoint &amp; Monitoring"><bpmn:flowNodeRef>S_abl</bpmn:flowNodeRef><bpmn:flowNodeRef>S_meta</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="V_start" name="Ware ist versandbereit"><bpmn:outgoing>Flow_V_start_V_wa</bpmn:outgoing></bpmn:startEvent>
      <bpmn:manualTask id="V_wa" name="Warenausgang buchen"><bpmn:incoming>Flow_V_start_V_wa</bpmn:incoming><bpmn:outgoing>Flow_V_wa_F_fakt</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="F_fakt" name="Faktura im ERP anlegen und PDF erzeugen"><bpmn:incoming>Flow_V_wa_F_fakt</bpmn:incoming><bpmn:outgoing>Flow_F_fakt_F_gwSap</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="F_gwSap" name="SAP-Werk?"><bpmn:incoming>Flow_F_fakt_F_gwSap</bpmn:incoming><bpmn:outgoing>Flow_F_gwSap_F_edi</bpmn:outgoing><bpmn:outgoing>Flow_F_gwSap_K_upload</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="F_edi" name="E-Rechnung über EDIzone senden (eigener SAP-Prozess)"><bpmn:incoming>Flow_F_gwSap_F_edi</bpmn:incoming><bpmn:outgoing>Flow_F_edi_F_endEdi</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="F_endEdi" name="über SAP versendet"><bpmn:incoming>Flow_F_edi_F_endEdi</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="K_upload" name="PDF in den Konverter laden"><bpmn:incoming>Flow_F_gwSap_K_upload</bpmn:incoming><bpmn:outgoing>Flow_K_upload_K_erk</bpmn:outgoing></bpmn:userTask>
      <bpmn:callActivity id="K_erk" name="Erkennen und erfassen" calledElement="Process_ERechnung_Erfassen"><bpmn:documentation>Unterprozess: E-Rechnung Erkennen und erfassen
[[rms:modell=01NH6NP5HOJGTZLRKOSFF3DWOHRRV4CMOP]]</bpmn:documentation><bpmn:incoming>Flow_K_upload_K_erk</bpmn:incoming><bpmn:incoming>Flow_K_fix_K_erk</bpmn:incoming><bpmn:outgoing>Flow_K_erk_K_exp</bpmn:outgoing></bpmn:callActivity>
      <bpmn:callActivity id="K_exp" name="Prüfen und E-Rechnung erzeugen" calledElement="Process_ERechnung_Erzeugen"><bpmn:documentation>Unterprozess: E-Rechnung Prüfen und erzeugen
[[rms:modell=01NH6NP5H2DLCLK76FEZD3NJGW55W4XJUW]]</bpmn:documentation><bpmn:incoming>Flow_K_erk_K_exp</bpmn:incoming><bpmn:outgoing>Flow_K_exp_S_abl</bpmn:outgoing></bpmn:callActivity>
      <bpmn:boundaryEvent id="K_bErr" name="Prüfung nicht bestanden" attachedToRef="K_exp" cancelActivity="true"><bpmn:outgoing>Flow_K_bErr_K_fix</bpmn:outgoing><bpmn:errorEventDefinition id="K_bErr_def" errorRef="Error_Pruefung" /></bpmn:boundaryEvent>
      <bpmn:userTask id="K_fix" name="Daten korrigieren"><bpmn:incoming>Flow_K_bErr_K_fix</bpmn:incoming><bpmn:outgoing>Flow_K_fix_K_erk</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="S_abl" name="E-Rechnung, lesbares PDF und Prüfpfad in AR_&lt;Werk&gt; ablegen"><bpmn:incoming>Flow_K_exp_S_abl</bpmn:incoming><bpmn:outgoing>Flow_S_abl_S_meta</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="S_meta" name="Metadaten setzen (Ausgang, Format, konform, GoBD)"><bpmn:incoming>Flow_S_abl_S_meta</bpmn:incoming><bpmn:outgoing>Flow_S_meta_K_mail</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="K_mail" name="Mail-Entwurf mit Anhang erstellen (Outlook oder .eml)"><bpmn:incoming>Flow_S_meta_K_mail</bpmn:incoming><bpmn:outgoing>Flow_K_mail_F_send</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="F_send" name="Rechnung an den Kunden senden"><bpmn:incoming>Flow_K_mail_F_send</bpmn:incoming><bpmn:outgoing>Flow_F_send_F_end</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="F_end" name="versendet"><bpmn:incoming>Flow_F_send_F_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_V_start_V_wa" sourceRef="V_start" targetRef="V_wa" />
      <bpmn:sequenceFlow id="Flow_V_wa_F_fakt" sourceRef="V_wa" targetRef="F_fakt" />
      <bpmn:sequenceFlow id="Flow_F_fakt_F_gwSap" sourceRef="F_fakt" targetRef="F_gwSap" />
      <bpmn:sequenceFlow id="Flow_F_gwSap_F_edi" sourceRef="F_gwSap" targetRef="F_edi" name="ja" />
      <bpmn:sequenceFlow id="Flow_F_edi_F_endEdi" sourceRef="F_edi" targetRef="F_endEdi" />
      <bpmn:sequenceFlow id="Flow_F_gwSap_K_upload" sourceRef="F_gwSap" targetRef="K_upload" name="nein" />
      <bpmn:sequenceFlow id="Flow_K_upload_K_erk" sourceRef="K_upload" targetRef="K_erk" />
      <bpmn:sequenceFlow id="Flow_K_erk_K_exp" sourceRef="K_erk" targetRef="K_exp" />
      <bpmn:sequenceFlow id="Flow_K_bErr_K_fix" sourceRef="K_bErr" targetRef="K_fix" />
      <bpmn:sequenceFlow id="Flow_K_fix_K_erk" sourceRef="K_fix" targetRef="K_erk" name="erneut" />
      <bpmn:sequenceFlow id="Flow_K_exp_S_abl" sourceRef="K_exp" targetRef="S_abl" />
      <bpmn:sequenceFlow id="Flow_S_abl_S_meta" sourceRef="S_abl" targetRef="S_meta" />
      <bpmn:sequenceFlow id="Flow_S_meta_K_mail" sourceRef="S_meta" targetRef="K_mail" />
      <bpmn:sequenceFlow id="Flow_K_mail_F_send" sourceRef="K_mail" targetRef="F_send" />
      <bpmn:sequenceFlow id="Flow_F_send_F_end" sourceRef="F_send" targetRef="F_end" />
      <bpmn:textAnnotation id="N_edi"><bpmn:text>SAP-Werke laufen über EDIzone, nicht über dieses Tool.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_edi" associationDirection="None" sourceRef="F_edi" targetRef="N_edi" />
      <bpmn:textAnnotation id="N_mail"><bpmn:text>Alternativ Datei herunterladen und über das Kundenportal hochladen.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_mail" associationDirection="None" sourceRef="K_mail" targetRef="N_mail" />
  </bpmn:process>
