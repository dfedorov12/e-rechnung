<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Ausgang" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="1.0">
  <bpmn:error id="Error_Pruefung" name="Prüfung nicht bestanden" errorCode="PRUEFUNG" />
  <bpmn:collaboration id="Collab_Ausgang">
    <bpmn:participant id="P_Kunde" name="Kunde" processRef="Proc_P_Kunde" />
    <bpmn:participant id="P_Aus" name="DIHAG · Rechnungsausgang (je Werk)" processRef="Proc_P_Aus" />
    <bpmn:messageFlow id="Msg_F_send_Ku_recv" name="E-Rechnung (ZUGFeRD oder XRechnung)" sourceRef="F_send" targetRef="Ku_recv" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_Kunde" name="Kunde" isExecutable="false">
      <bpmn:startEvent id="Ku_recv" name="E-Rechnung empfangen"><bpmn:outgoing>Flow_Ku_recv_Ku_end</bpmn:outgoing><bpmn:messageEventDefinition id="Ku_recv_def" /></bpmn:startEvent>
      <bpmn:endEvent id="Ku_end" name="Rechnung liegt beim Kunden"><bpmn:incoming>Flow_Ku_recv_Ku_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Ku_recv_Ku_end" sourceRef="Ku_recv" targetRef="Ku_end" />
  </bpmn:process>
  <bpmn:process id="Proc_P_Aus" name="DIHAG · Rechnungsausgang (je Werk)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_Aus">
      <bpmn:lane id="LV" name="Versand / Lager"><bpmn:flowNodeRef>V_start</bpmn:flowNodeRef><bpmn:flowNodeRef>V_wa</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LF" name="Vertrieb / Fakturierung"><bpmn:flowNodeRef>F_fakt</bpmn:flowNodeRef><bpmn:flowNodeRef>F_gwSap</bpmn:flowNodeRef><bpmn:flowNodeRef>F_edi</bpmn:flowNodeRef><bpmn:flowNodeRef>F_endEdi</bpmn:flowNodeRef><bpmn:flowNodeRef>F_send</bpmn:flowNodeRef><bpmn:flowNodeRef>F_end</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LK" name="Konverter (Browser-App)"><bpmn:flowNodeRef>K_upload</bpmn:flowNodeRef><bpmn:flowNodeRef>K_erk</bpmn:flowNodeRef><bpmn:flowNodeRef>K_exp</bpmn:flowNodeRef><bpmn:flowNodeRef>K_bErr</bpmn:flowNodeRef><bpmn:flowNodeRef>K_fix</bpmn:flowNodeRef><bpmn:flowNodeRef>K_mail</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LS" name="SharePoint &amp; Monitoring"><bpmn:flowNodeRef>S_abl</bpmn:flowNodeRef><bpmn:flowNodeRef>S_meta</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="V_start" name="Ware ist versandbereit"><bpmn:outgoing>Flow_V_start_V_wa</bpmn:outgoing></bpmn:startEvent>
      <bpmn:manualTask id="V_wa" name="Warenausgang buchen"><bpmn:incoming>Flow_V_start_V_wa</bpmn:incoming><bpmn:outgoing>Flow_V_wa_F_fakt</bpmn:outgoing></bpmn:manualTask>
      <bpmn:userTask id="F_fakt" name="Faktura im ERP anlegen und PDF erzeugen"><bpmn:incoming>Flow_V_wa_F_fakt</bpmn:incoming><bpmn:outgoing>Flow_F_fakt_F_gwSap</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="F_gwSap" name="SAP-Werk?"><bpmn:incoming>Flow_F_fakt_F_gwSap</bpmn:incoming><bpmn:outgoing>Flow_F_gwSap_F_edi</bpmn:outgoing><bpmn:outgoing>Flow_F_gwSap_K_upload</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="F_edi" name="E-Rechnung über EDIzone (eigener SAP-Prozess)"><bpmn:incoming>Flow_F_gwSap_F_edi</bpmn:incoming><bpmn:outgoing>Flow_F_edi_F_endEdi</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="F_endEdi" name="über SAP versendet"><bpmn:incoming>Flow_F_edi_F_endEdi</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="K_upload" name="PDF in den Konverter laden"><bpmn:incoming>Flow_F_gwSap_K_upload</bpmn:incoming><bpmn:outgoing>Flow_K_upload_K_erk</bpmn:outgoing></bpmn:userTask>
      <bpmn:subProcess id="K_erk" name="Erkennen und erfassen"><bpmn:incoming>Flow_K_upload_K_erk</bpmn:incoming><bpmn:incoming>Flow_K_fix_K_erk</bpmn:incoming><bpmn:outgoing>Flow_K_erk_K_exp</bpmn:outgoing>
      <bpmn:startEvent id="E_start" name="PDF hochgeladen"><bpmn:outgoing>Flow_E_start_E_gwText</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="E_gwText" name="Textebene vorhanden?"><bpmn:incoming>Flow_E_start_E_gwText</bpmn:incoming><bpmn:outgoing>Flow_E_gwText_E_join1</bpmn:outgoing><bpmn:outgoing>Flow_E_gwText_E_ocr</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="E_ocr" name="Texterkennung (OCR)"><bpmn:incoming>Flow_E_gwText_E_ocr</bpmn:incoming><bpmn:outgoing>Flow_E_ocr_E_join1</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="E_join1"><bpmn:incoming>Flow_E_gwText_E_join1</bpmn:incoming><bpmn:incoming>Flow_E_ocr_E_join1</bpmn:incoming><bpmn:outgoing>Flow_E_join1_E_werk</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="E_werk" name="Werk erkennen, passenden Rechnungs-Parser wählen"><bpmn:incoming>Flow_E_join1_E_werk</bpmn:incoming><bpmn:outgoing>Flow_E_werk_E_fill</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="E_fill" name="Felder vorbefüllen, Verkäufer-Stammdaten sperren"><bpmn:incoming>Flow_E_werk_E_fill</bpmn:incoming><bpmn:outgoing>Flow_E_fill_E_check</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="E_check" name="Daten prüfen und ergänzen (Belegart, Leitweg-ID, Lieferschein)"><bpmn:incoming>Flow_E_fill_E_check</bpmn:incoming><bpmn:outgoing>Flow_E_check_E_gwEU</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="E_gwEU" name="Kunde im EU-Ausland mit USt-IdNr?"><bpmn:incoming>Flow_E_check_E_gwEU</bpmn:incoming><bpmn:outgoing>Flow_E_gwEU_E_join2</bpmn:outgoing><bpmn:outgoing>Flow_E_gwEU_E_vat</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="E_vat" name="Qualifizierte USt-IdNr-Prüfung (BZSt / VIES), Nachweis sichern"><bpmn:incoming>Flow_E_gwEU_E_vat</bpmn:incoming><bpmn:outgoing>Flow_E_vat_E_join2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="E_join2"><bpmn:incoming>Flow_E_gwEU_E_join2</bpmn:incoming><bpmn:incoming>Flow_E_vat_E_join2</bpmn:incoming><bpmn:outgoing>Flow_E_join2_E_fmt</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="E_fmt" name="Format wählen: ZUGFeRD (Standard) oder XRechnung"><bpmn:incoming>Flow_E_join2_E_fmt</bpmn:incoming><bpmn:outgoing>Flow_E_fmt_E_end</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="E_end" name="Daten vollständig"><bpmn:incoming>Flow_E_fmt_E_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_E_start_E_gwText" sourceRef="E_start" targetRef="E_gwText" />
      <bpmn:sequenceFlow id="Flow_E_gwText_E_join1" sourceRef="E_gwText" targetRef="E_join1" name="ja" />
      <bpmn:sequenceFlow id="Flow_E_gwText_E_ocr" sourceRef="E_gwText" targetRef="E_ocr" name="nein, Scan" />
      <bpmn:sequenceFlow id="Flow_E_ocr_E_join1" sourceRef="E_ocr" targetRef="E_join1" />
      <bpmn:sequenceFlow id="Flow_E_join1_E_werk" sourceRef="E_join1" targetRef="E_werk" />
      <bpmn:sequenceFlow id="Flow_E_werk_E_fill" sourceRef="E_werk" targetRef="E_fill" />
      <bpmn:sequenceFlow id="Flow_E_fill_E_check" sourceRef="E_fill" targetRef="E_check" />
      <bpmn:sequenceFlow id="Flow_E_check_E_gwEU" sourceRef="E_check" targetRef="E_gwEU" />
      <bpmn:sequenceFlow id="Flow_E_gwEU_E_join2" sourceRef="E_gwEU" targetRef="E_join2" name="nein" />
      <bpmn:sequenceFlow id="Flow_E_gwEU_E_vat" sourceRef="E_gwEU" targetRef="E_vat" name="ja" />
      <bpmn:sequenceFlow id="Flow_E_vat_E_join2" sourceRef="E_vat" targetRef="E_join2" />
      <bpmn:sequenceFlow id="Flow_E_join2_E_fmt" sourceRef="E_join2" targetRef="E_fmt" />
      <bpmn:sequenceFlow id="Flow_E_fmt_E_end" sourceRef="E_fmt" targetRef="E_end" />
      <bpmn:textAnnotation id="EN_werk"><bpmn:text>Eigene Parser: WGC, SHB, ZAI. Weitere Werke folgen.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_EN_werk" associationDirection="None" sourceRef="E_werk" targetRef="EN_werk" />
      <bpmn:textAnnotation id="EN_fill"><bpmn:text>Entsperren nur bewusst, es landet im Prüfpfad.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_EN_fill" associationDirection="None" sourceRef="E_fill" targetRef="EN_fill" />
      <bpmn:textAnnotation id="EN_fmt"><bpmn:text>Standard ist ZUGFeRD. XRechnung z. B. für öffentliche Auftraggeber mit Leitweg-ID.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_EN_fmt" associationDirection="None" sourceRef="E_fmt" targetRef="EN_fmt" />
      </bpmn:subProcess>
      <bpmn:subProcess id="K_exp" name="Prüfen und E-Rechnung erzeugen"><bpmn:incoming>Flow_K_erk_K_exp</bpmn:incoming><bpmn:outgoing>Flow_K_exp_S_abl</bpmn:outgoing>
      <bpmn:startEvent id="X_start" name="Export angestoßen"><bpmn:outgoing>Flow_X_start_X_pflicht</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="X_pflicht" name="Pflichtfelder prüfen"><bpmn:incoming>Flow_X_start_X_pflicht</bpmn:incoming><bpmn:outgoing>Flow_X_pflicht_X_pre</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="X_pre" name="Vorabprüfung: IBAN-Prüfziffer, Summen, USt-IdNr-Format"><bpmn:incoming>Flow_X_pflicht_X_pre</bpmn:incoming><bpmn:outgoing>Flow_X_pre_X_gwHard</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="X_gwHard" name="Harter Fehler?"><bpmn:incoming>Flow_X_pre_X_gwHard</bpmn:incoming><bpmn:outgoing>Flow_X_gwHard_X_err1</bpmn:outgoing><bpmn:outgoing>Flow_X_gwHard_X_gwSoft</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="X_err1" name="Prüfung nicht bestanden"><bpmn:incoming>Flow_X_gwHard_X_err1</bpmn:incoming><bpmn:errorEventDefinition id="X_err1_def" errorRef="Error_Pruefung" /></bpmn:endEvent>
      <bpmn:exclusiveGateway id="X_gwSoft" name="Abweichung zum Original-PDF?"><bpmn:incoming>Flow_X_gwHard_X_gwSoft</bpmn:incoming><bpmn:outgoing>Flow_X_gwSoft_X_join1</bpmn:outgoing><bpmn:outgoing>Flow_X_gwSoft_X_confirm</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="X_confirm" name="Warnung ansehen: fortfahren oder abbrechen"><bpmn:incoming>Flow_X_gwSoft_X_confirm</bpmn:incoming><bpmn:outgoing>Flow_X_confirm_X_join1</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="X_join1"><bpmn:incoming>Flow_X_gwSoft_X_join1</bpmn:incoming><bpmn:incoming>Flow_X_confirm_X_join1</bpmn:incoming><bpmn:outgoing>Flow_X_join1_X_xml</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="X_xml" name="XML nach EN 16931 erzeugen"><bpmn:incoming>Flow_X_join1_X_xml</bpmn:incoming><bpmn:outgoing>Flow_X_xml_X_self</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="X_self" name="Selbstprüfung: XML zurücklesen und vergleichen"><bpmn:incoming>Flow_X_xml_X_self</bpmn:incoming><bpmn:outgoing>Flow_X_self_X_gwSelf</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="X_gwSelf" name="Abweichung?"><bpmn:incoming>Flow_X_self_X_gwSelf</bpmn:incoming><bpmn:outgoing>Flow_X_gwSelf_X_err2</bpmn:outgoing><bpmn:outgoing>Flow_X_gwSelf_X_gwFmt</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="X_err2" name="Selbstprüfung fehlgeschlagen"><bpmn:incoming>Flow_X_gwSelf_X_err2</bpmn:incoming><bpmn:errorEventDefinition id="X_err2_def" errorRef="Error_Pruefung" /></bpmn:endEvent>
      <bpmn:exclusiveGateway id="X_gwFmt" name="Format?"><bpmn:incoming>Flow_X_gwSelf_X_gwFmt</bpmn:incoming><bpmn:outgoing>Flow_X_gwFmt_X_zf</bpmn:outgoing><bpmn:outgoing>Flow_X_gwFmt_X_xr</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="X_zf" name="ZUGFeRD: PDF/A-3b mit eingebetteter XML"><bpmn:incoming>Flow_X_gwFmt_X_zf</bpmn:incoming><bpmn:outgoing>Flow_X_zf_X_join2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="X_xr" name="XRechnung-XML plus lesbares PDF"><bpmn:incoming>Flow_X_gwFmt_X_xr</bpmn:incoming><bpmn:outgoing>Flow_X_xr_X_join2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="X_join2"><bpmn:incoming>Flow_X_zf_X_join2</bpmn:incoming><bpmn:incoming>Flow_X_xr_X_join2</bpmn:incoming><bpmn:outgoing>Flow_X_join2_X_audit</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="X_audit" name="Prüfpfad: Hash, manuelle Änderungen, Prüfer"><bpmn:incoming>Flow_X_join2_X_audit</bpmn:incoming><bpmn:outgoing>Flow_X_audit_X_dl</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="X_dl" name="Dateien herunterladen"><bpmn:incoming>Flow_X_audit_X_dl</bpmn:incoming><bpmn:outgoing>Flow_X_dl_X_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="X_end" name="E-Rechnung erstellt"><bpmn:incoming>Flow_X_dl_X_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_X_start_X_pflicht" sourceRef="X_start" targetRef="X_pflicht" />
      <bpmn:sequenceFlow id="Flow_X_pflicht_X_pre" sourceRef="X_pflicht" targetRef="X_pre" />
      <bpmn:sequenceFlow id="Flow_X_pre_X_gwHard" sourceRef="X_pre" targetRef="X_gwHard" />
      <bpmn:sequenceFlow id="Flow_X_gwHard_X_err1" sourceRef="X_gwHard" targetRef="X_err1" name="ja" />
      <bpmn:sequenceFlow id="Flow_X_gwHard_X_gwSoft" sourceRef="X_gwHard" targetRef="X_gwSoft" name="nein" />
      <bpmn:sequenceFlow id="Flow_X_gwSoft_X_join1" sourceRef="X_gwSoft" targetRef="X_join1" name="nein" />
      <bpmn:sequenceFlow id="Flow_X_gwSoft_X_confirm" sourceRef="X_gwSoft" targetRef="X_confirm" name="ja" />
      <bpmn:sequenceFlow id="Flow_X_confirm_X_join1" sourceRef="X_confirm" targetRef="X_join1" name="fortfahren" />
      <bpmn:sequenceFlow id="Flow_X_join1_X_xml" sourceRef="X_join1" targetRef="X_xml" />
      <bpmn:sequenceFlow id="Flow_X_xml_X_self" sourceRef="X_xml" targetRef="X_self" />
      <bpmn:sequenceFlow id="Flow_X_self_X_gwSelf" sourceRef="X_self" targetRef="X_gwSelf" />
      <bpmn:sequenceFlow id="Flow_X_gwSelf_X_err2" sourceRef="X_gwSelf" targetRef="X_err2" name="ja" />
      <bpmn:sequenceFlow id="Flow_X_gwSelf_X_gwFmt" sourceRef="X_gwSelf" targetRef="X_gwFmt" name="nein" />
      <bpmn:sequenceFlow id="Flow_X_gwFmt_X_zf" sourceRef="X_gwFmt" targetRef="X_zf" name="ZUGFeRD" />
      <bpmn:sequenceFlow id="Flow_X_gwFmt_X_xr" sourceRef="X_gwFmt" targetRef="X_xr" name="XRechnung" />
      <bpmn:sequenceFlow id="Flow_X_zf_X_join2" sourceRef="X_zf" targetRef="X_join2" />
      <bpmn:sequenceFlow id="Flow_X_xr_X_join2" sourceRef="X_xr" targetRef="X_join2" />
      <bpmn:sequenceFlow id="Flow_X_join2_X_audit" sourceRef="X_join2" targetRef="X_audit" />
      <bpmn:sequenceFlow id="Flow_X_audit_X_dl" sourceRef="X_audit" targetRef="X_dl" />
      <bpmn:sequenceFlow id="Flow_X_dl_X_end" sourceRef="X_dl" targetRef="X_end" />
      <bpmn:textAnnotation id="XN_pre"><bpmn:text>Harte Fehler: IBAN-Prüfziffer falsch, Summe nicht plausibel, Netto + MwSt ≠ Brutto.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_XN_pre" associationDirection="None" sourceRef="X_pre" targetRef="XN_pre" />
      <bpmn:textAnnotation id="XN_confirm"><bpmn:text>„Abbrechen“ beendet den Export, es entsteht keine Datei.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_XN_confirm" associationDirection="None" sourceRef="X_confirm" targetRef="XN_confirm" />
      <bpmn:textAnnotation id="XN_zf"><bpmn:text>Standard: Das PDF wird aus den Rechnungsdaten erzeugt, PDF und XML sind identisch.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_XN_zf" associationDirection="None" sourceRef="X_zf" targetRef="XN_zf" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="K_bErr" name="Prüfung nicht bestanden" attachedToRef="K_exp" cancelActivity="true"><bpmn:outgoing>Flow_K_bErr_K_fix</bpmn:outgoing><bpmn:errorEventDefinition id="K_bErr_def" errorRef="Error_Pruefung" /></bpmn:boundaryEvent>
      <bpmn:userTask id="K_fix" name="Daten korrigieren"><bpmn:incoming>Flow_K_bErr_K_fix</bpmn:incoming><bpmn:outgoing>Flow_K_fix_K_erk</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="S_abl" name="In AR_&lt;Werk&gt; ablegen: E-Rechnung, lesbares PDF, Prüfpfad"><bpmn:incoming>Flow_K_exp_S_abl</bpmn:incoming><bpmn:outgoing>Flow_S_abl_S_meta</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="S_meta" name="Metadaten setzen: Ausgang, Format, konform, GoBD"><bpmn:incoming>Flow_S_abl_S_meta</bpmn:incoming><bpmn:outgoing>Flow_S_meta_K_mail</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="K_mail" name="Mail-Entwurf mit Anhang erstellen (Outlook oder .eml)"><bpmn:incoming>Flow_S_meta_K_mail</bpmn:incoming><bpmn:outgoing>Flow_K_mail_F_send</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="F_send" name="Rechnung an den Kunden senden"><bpmn:incoming>Flow_K_mail_F_send</bpmn:incoming><bpmn:outgoing>Flow_F_send_F_end</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="F_end" name="versendet"><bpmn:incoming>Flow_F_send_F_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_V_start_V_wa" sourceRef="V_start" targetRef="V_wa" />
      <bpmn:sequenceFlow id="Flow_V_wa_F_fakt" sourceRef="V_wa" targetRef="F_fakt" />
      <bpmn:sequenceFlow id="Flow_F_fakt_F_gwSap" sourceRef="F_fakt" targetRef="F_gwSap" />
      <bpmn:sequenceFlow id="Flow_F_gwSap_F_edi" sourceRef="F_gwSap" targetRef="F_edi" name="ja" />
      <bpmn:sequenceFlow id="Flow_F_edi_F_endEdi" sourceRef="F_edi" targetRef="F_endEdi" />
      <bpmn:sequenceFlow id="Flow_F_gwSap_K_upload" sourceRef="F_gwSap" targetRef="K_upload" name="nein" />
      <bpmn:sequenceFlow id="Flow_K_upload_K_erk" sourceRef="K_upload" targetRef="K_erk" />
      <bpmn:sequenceFlow id="Flow_K_erk_K_exp" sourceRef="K_erk" targetRef="K_exp" />
      <bpmn:sequenceFlow id="Flow_K_bErr_K_fix" sourceRef="K_bErr" targetRef="K_fix" />
      <bpmn:sequenceFlow id="Flow_K_fix_K_erk" sourceRef="K_fix" targetRef="K_erk" name="erneut" />
      <bpmn:sequenceFlow id="Flow_K_exp_S_abl" sourceRef="K_exp" targetRef="S_abl" />
      <bpmn:sequenceFlow id="Flow_S_abl_S_meta" sourceRef="S_abl" targetRef="S_meta" />
      <bpmn:sequenceFlow id="Flow_S_meta_K_mail" sourceRef="S_meta" targetRef="K_mail" />
