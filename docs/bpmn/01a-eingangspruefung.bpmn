<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_intake" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_intake">
    <bpmn:participant id="P_Intake" name="Eingangsprüfung" processRef="Process_ERechnung_Eingangspruefung" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ERechnung_Eingangspruefung" name="E-Rechnung Eingangsprüfung" isExecutable="false">
    <bpmn:documentation>Der Prüfdienst /api/intake prüft jeden Anhang: Art erkennen, PDF/A-Hülle und eingebettete XML (ZUGFeRD) oder XRechnung validieren, Kopfdaten lesen, Steuerkategorie und Abgleich PDF zu XML bewerten. Ergebnis ist ein JSON mit Buchungsweg und Prüf-Flags.
Eingebunden in: E-Rechnung Rechnungseingang.
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#eingang
Im Einklang mit den Richtlinien: ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Intake">
      <bpmn:lane id="LI" name="Prüfdienst (Azure)"><bpmn:flowNodeRef>I_start</bpmn:flowNodeRef><bpmn:flowNodeRef>I_norm</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gwTyp</bpmn:flowNodeRef><bpmn:flowNodeRef>I_pdfa</bpmn:flowNodeRef><bpmn:flowNodeRef>I_extract</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gwEinv</bpmn:flowNodeRef><bpmn:flowNodeRef>I_lief</bpmn:flowNodeRef><bpmn:flowNodeRef>I_sonst</bpmn:flowNodeRef><bpmn:flowNodeRef>I_endSonst</bpmn:flowNodeRef><bpmn:flowNodeRef>I_zf</bpmn:flowNodeRef><bpmn:flowNodeRef>I_mustang</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gwMin</bpmn:flowNodeRef><bpmn:flowNodeRef>I_rej</bpmn:flowNodeRef><bpmn:flowNodeRef>I_endRej</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gwPdfa</bpmn:flowNodeRef><bpmn:flowNodeRef>I_fm</bpmn:flowNodeRef><bpmn:flowNodeRef>I_xr</bpmn:flowNodeRef><bpmn:flowNodeRef>I_kosit</bpmn:flowNodeRef><bpmn:flowNodeRef>I_daten</bpmn:flowNodeRef><bpmn:flowNodeRef>I_werk</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gwSt</bpmn:flowNodeRef><bpmn:flowNodeRef>I_man</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gwZf</bpmn:flowNodeRef><bpmn:flowNodeRef>I_abgl</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gwMat</bpmn:flowNodeRef><bpmn:flowNodeRef>I_rf</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gwRend</bpmn:flowNodeRef><bpmn:flowNodeRef>I_render</bpmn:flowNodeRef><bpmn:flowNodeRef>I_end</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="I_start" name="Anhang vom Flow"><bpmn:outgoing>Flow_I_start_I_norm</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="I_norm" name="Inhalt erkennen (PDF, XML, base64 oder Flow-Hülle)"><bpmn:incoming>Flow_I_start_I_norm</bpmn:incoming><bpmn:outgoing>Flow_I_norm_I_gwTyp</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwTyp" name="PDF oder XML?"><bpmn:incoming>Flow_I_norm_I_gwTyp</bpmn:incoming><bpmn:outgoing>Flow_I_gwTyp_I_pdfa</bpmn:outgoing><bpmn:outgoing>Flow_I_gwTyp_I_xr</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_pdfa" name="PDF/A-Hülle mit veraPDF prüfen"><bpmn:incoming>Flow_I_gwTyp_I_pdfa</bpmn:incoming><bpmn:outgoing>Flow_I_pdfa_I_extract</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_extract" name="Eingebettete XML suchen"><bpmn:incoming>Flow_I_pdfa_I_extract</bpmn:incoming><bpmn:outgoing>Flow_I_extract_I_gwEinv</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwEinv" name="Echte E-Rechnung (CII oder UBL) eingebettet?"><bpmn:incoming>Flow_I_extract_I_gwEinv</bpmn:incoming><bpmn:outgoing>Flow_I_gwEinv_I_zf</bpmn:outgoing><bpmn:outgoing>Flow_I_gwEinv_I_lief</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_lief" name="Lieferant, USt-IdNr., Nummer und Datum aus dem PDF-Text lesen"><bpmn:incoming>Flow_I_gwEinv_I_lief</bpmn:incoming><bpmn:outgoing>Flow_I_lief_I_sonst</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_sonst" name="Sonstige Rechnung: unter Vorbehalt, Berichtigung anfordern"><bpmn:incoming>Flow_I_lief_I_sonst</bpmn:incoming><bpmn:outgoing>Flow_I_sonst_I_endSonst</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="I_endSonst" name="Ergebnis: sonstige Rechnung"><bpmn:incoming>Flow_I_sonst_I_endSonst</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="I_zf" name="Als ZUGFeRD einordnen"><bpmn:incoming>Flow_I_gwEinv_I_zf</bpmn:incoming><bpmn:outgoing>Flow_I_zf_I_mustang</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_mustang" name="Tatsächliches Profil mit Mustang prüfen (mit Prüfbericht)"><bpmn:incoming>Flow_I_zf_I_mustang</bpmn:incoming><bpmn:outgoing>Flow_I_mustang_I_gwMin</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwMin" name="Profil MINIMUM oder BASIC-WL?"><bpmn:incoming>Flow_I_mustang_I_gwMin</bpmn:incoming><bpmn:outgoing>Flow_I_gwMin_I_rej</bpmn:outgoing><bpmn:outgoing>Flow_I_gwMin_I_gwPdfa</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_rej" name="Als keine E-Rechnung zurückweisen (harter Stopp)"><bpmn:incoming>Flow_I_gwMin_I_rej</bpmn:incoming><bpmn:outgoing>Flow_I_rej_I_endRej</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="I_endRej" name="Ergebnis: zurückgewiesen"><bpmn:incoming>Flow_I_rej_I_endRej</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="I_gwPdfa" name="PDF/A-3 in Ordnung?"><bpmn:incoming>Flow_I_gwMin_I_gwPdfa</bpmn:incoming><bpmn:outgoing>Flow_I_gwPdfa_I_daten</bpmn:outgoing><bpmn:outgoing>Flow_I_gwPdfa_I_fm</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_fm" name="Formatmangel: unter Vorbehalt, Berichtigung anfordern"><bpmn:incoming>Flow_I_gwPdfa_I_fm</bpmn:incoming><bpmn:outgoing>Flow_I_fm_I_daten</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_xr" name="Als XRechnung einordnen (reine XML)"><bpmn:incoming>Flow_I_gwTyp_I_xr</bpmn:incoming><bpmn:outgoing>Flow_I_xr_I_kosit</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_kosit" name="XRechnung / EN 16931 mit KoSIT prüfen (mit Prüfbericht)"><bpmn:incoming>Flow_I_xr_I_kosit</bpmn:incoming><bpmn:outgoing>Flow_I_kosit_I_daten</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_daten" name="Kopfdaten lesen (Nummer, Datum, Beträge, Steuerkategorie)"><bpmn:incoming>Flow_I_gwPdfa_I_daten</bpmn:incoming><bpmn:incoming>Flow_I_fm_I_daten</bpmn:incoming><bpmn:incoming>Flow_I_kosit_I_daten</bpmn:incoming><bpmn:outgoing>Flow_I_daten_I_werk</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_werk" name="Richtung und Werk bestimmen (mit Empfänger-Gegenprobe)"><bpmn:incoming>Flow_I_daten_I_werk</bpmn:incoming><bpmn:outgoing>Flow_I_werk_I_gwSt</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwSt" name="Steuerkategorie AE, K, G, E oder O?"><bpmn:incoming>Flow_I_werk_I_gwSt</bpmn:incoming><bpmn:outgoing>Flow_I_gwSt_I_man</bpmn:outgoing><bpmn:outgoing>Flow_I_gwSt_I_gwZf</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_man" name="Buchungsweg „manuell“ setzen (Vier-Augen-Prüfung nötig)"><bpmn:incoming>Flow_I_gwSt_I_man</bpmn:incoming><bpmn:outgoing>Flow_I_man_I_gwZf</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwZf" name="Quelle ZUGFeRD?"><bpmn:incoming>Flow_I_gwSt_I_gwZf</bpmn:incoming><bpmn:incoming>Flow_I_man_I_gwZf</bpmn:incoming><bpmn:outgoing>Flow_I_gwZf_I_abgl</bpmn:outgoing><bpmn:outgoing>Flow_I_gwZf_I_gwRend</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_abgl" name="PDF und XML abgleichen (Nummer, Steuer, Brutto, rundungstolerant)"><bpmn:incoming>Flow_I_gwZf_I_abgl</bpmn:incoming><bpmn:outgoing>Flow_I_abgl_I_gwMat</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwMat" name="Materielle Abweichung?"><bpmn:incoming>Flow_I_abgl_I_gwMat</bpmn:incoming><bpmn:outgoing>Flow_I_gwMat_I_rf</bpmn:outgoing><bpmn:outgoing>Flow_I_gwMat_I_gwRend</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_rf" name="Rückfrage-Flag setzen (die XML bleibt maßgeblich)"><bpmn:incoming>Flow_I_gwMat_I_rf</bpmn:incoming><bpmn:outgoing>Flow_I_rf_I_gwRend</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gwRend" name="XRechnung-XML oder Formatmangel?"><bpmn:incoming>Flow_I_gwZf_I_gwRend</bpmn:incoming><bpmn:incoming>Flow_I_gwMat_I_gwRend</bpmn:incoming><bpmn:incoming>Flow_I_rf_I_gwRend</bpmn:incoming><bpmn:outgoing>Flow_I_gwRend_I_render</bpmn:outgoing><bpmn:outgoing>Flow_I_gwRend_I_end</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_render" name="Lesbares PDF/A-3b aus der XML erzeugen"><bpmn:incoming>Flow_I_gwRend_I_render</bpmn:incoming><bpmn:outgoing>Flow_I_render_I_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="I_end" name="Prüfergebnis an den Flow (JSON)"><bpmn:incoming>Flow_I_gwRend_I_end</bpmn:incoming><bpmn:incoming>Flow_I_render_I_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_I_start_I_norm" sourceRef="I_start" targetRef="I_norm" />
      <bpmn:sequenceFlow id="Flow_I_norm_I_gwTyp" sourceRef="I_norm" targetRef="I_gwTyp" />
      <bpmn:sequenceFlow id="Flow_I_gwTyp_I_pdfa" sourceRef="I_gwTyp" targetRef="I_pdfa" name="PDF" />
      <bpmn:sequenceFlow id="Flow_I_gwTyp_I_xr" sourceRef="I_gwTyp" targetRef="I_xr" name="XML" />
      <bpmn:sequenceFlow id="Flow_I_pdfa_I_extract" sourceRef="I_pdfa" targetRef="I_extract" />
      <bpmn:sequenceFlow id="Flow_I_extract_I_gwEinv" sourceRef="I_extract" targetRef="I_gwEinv" />
      <bpmn:sequenceFlow id="Flow_I_gwEinv_I_zf" sourceRef="I_gwEinv" targetRef="I_zf" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwEinv_I_lief" sourceRef="I_gwEinv" targetRef="I_lief" name="nein oder fremde XML" />
      <bpmn:sequenceFlow id="Flow_I_lief_I_sonst" sourceRef="I_lief" targetRef="I_sonst" />
      <bpmn:sequenceFlow id="Flow_I_sonst_I_endSonst" sourceRef="I_sonst" targetRef="I_endSonst" />
      <bpmn:sequenceFlow id="Flow_I_zf_I_mustang" sourceRef="I_zf" targetRef="I_mustang" />
      <bpmn:sequenceFlow id="Flow_I_mustang_I_gwMin" sourceRef="I_mustang" targetRef="I_gwMin" />
      <bpmn:sequenceFlow id="Flow_I_gwMin_I_rej" sourceRef="I_gwMin" targetRef="I_rej" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_rej_I_endRej" sourceRef="I_rej" targetRef="I_endRej" />
      <bpmn:sequenceFlow id="Flow_I_gwMin_I_gwPdfa" sourceRef="I_gwMin" targetRef="I_gwPdfa" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_gwPdfa_I_daten" sourceRef="I_gwPdfa" targetRef="I_daten" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwPdfa_I_fm" sourceRef="I_gwPdfa" targetRef="I_fm" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_fm_I_daten" sourceRef="I_fm" targetRef="I_daten" />
      <bpmn:sequenceFlow id="Flow_I_xr_I_kosit" sourceRef="I_xr" targetRef="I_kosit" />
      <bpmn:sequenceFlow id="Flow_I_kosit_I_daten" sourceRef="I_kosit" targetRef="I_daten" />
      <bpmn:sequenceFlow id="Flow_I_daten_I_werk" sourceRef="I_daten" targetRef="I_werk" />
      <bpmn:sequenceFlow id="Flow_I_werk_I_gwSt" sourceRef="I_werk" targetRef="I_gwSt" />
      <bpmn:sequenceFlow id="Flow_I_gwSt_I_man" sourceRef="I_gwSt" targetRef="I_man" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwSt_I_gwZf" sourceRef="I_gwSt" targetRef="I_gwZf" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_man_I_gwZf" sourceRef="I_man" targetRef="I_gwZf" />
      <bpmn:sequenceFlow id="Flow_I_gwZf_I_abgl" sourceRef="I_gwZf" targetRef="I_abgl" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwZf_I_gwRend" sourceRef="I_gwZf" targetRef="I_gwRend" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_abgl_I_gwMat" sourceRef="I_abgl" targetRef="I_gwMat" />
      <bpmn:sequenceFlow id="Flow_I_gwMat_I_rf" sourceRef="I_gwMat" targetRef="I_rf" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwMat_I_gwRend" sourceRef="I_gwMat" targetRef="I_gwRend" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_rf_I_gwRend" sourceRef="I_rf" targetRef="I_gwRend" />
      <bpmn:sequenceFlow id="Flow_I_gwRend_I_render" sourceRef="I_gwRend" targetRef="I_render" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gwRend_I_end" sourceRef="I_gwRend" targetRef="I_end" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_render_I_end" sourceRef="I_render" targetRef="I_end" />
      <bpmn:textAnnotation id="IN_sonst"><bpmn:text>Auch fremde XML (z. B. openTRANS) zählt nicht als E-Rechnung. Die Kopfdaten aus dem Text sind ein Vorschlag, was unsicher ist, bleibt leer. Übergang: sonstige Rechnungen bis 31.12.2026 zulässig, bei Vorjahresumsatz bis 800.000 € bis 31.12.2027.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_IN_sonst" associationDirection="None" sourceRef="I_sonst" targetRef="IN_sonst" />
      <bpmn:textAnnotation id="IN_kosit"><bpmn:text>Nur formale Verstöße (Leitweg-ID, elektronische Adresse) sind Hinweise und werten nicht ab.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_IN_kosit" associationDirection="None" sourceRef="I_kosit" targetRef="IN_kosit" />
      <bpmn:textAnnotation id="IN_werk"><bpmn:text>Ist eine DIHAG-Gesellschaft Verkäufer, gilt die Rechnung als Ausgang (Ablage in AR_&lt;Werk&gt;).</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_IN_werk" associationDirection="None" sourceRef="I_werk" targetRef="IN_werk" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_intake">
    <bpmndi:BPMNPlane id="Plane_intake" bpmnElement="Collab_intake">
