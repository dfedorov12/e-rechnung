      <bpmndi:BPMNShape id="I_endSonst_di" bpmnElement="I_endSonst" bioc:stroke="#A65F00" bioc:fill="#FFF1CC" color:background-color="#FFF1CC" color:border-color="#A65F00"><dc:Bounds x="1607" y="112" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1565" y="153" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
