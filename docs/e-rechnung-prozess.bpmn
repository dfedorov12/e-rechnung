<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ERechnung" targetNamespace="http://dihag.de/erechnung">
  <bpmn:process id="Process_ERechnung" name="DIHAG E-Rechnung (Ein- und Ausgang)" isExecutable="false">
    <bpmn:startEvent id="se_out" name="Ausgangsrechnung zu erstellen (Werk)">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="se_in" name="Eingangsrechnung trifft ein (ERP/Portal)">
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t_upload" name="Konverter: PDF hochladen oder Daten erfassen">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_felder" name="Konverter: Belegart (BT-3), Felder; Werk aus Firmenname erkennen">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_format" name="Format?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_xr" name="Konverter: XRechnung (XML) erzeugen">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_zf" name="Konverter: ZUGFeRD-PDF (PDF/A-3b + eingebettete XML) erzeugen">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_format_m">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_pruef" name="Konverter: Selbstpruefung + Pruefpfad (SHA-256, Audit)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_ar" name="SharePoint: Ablage in AR_&#60;Werk&#62; mit Metadaten">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_erar" name="ERP/Power Automate: Ablage in ERAR_&#60;Werk&#62;">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_trigger" name="Power Automate: Trigger &#34;Datei erstellt&#34; -&#62; Dateiinhalt abrufen">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_call" name="Power Automate: POST /api/validate">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_typ" name="XML oder PDF?">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_kosit" name="Azure: KoSIT prueft XRechnung-XML (EN 16931)">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_pdf" name="Azure: XML aus PDF extrahieren -&#62; KoSIT + veraPDF (PDF/A-3b)">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_typ_m">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_ergebnis" name="Azure: Ergebnis Konformitaet (gruen/gelb/rot) + PDF/A">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_konform" name="Konform?">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_fehler" name="Power Automate: Status=Fehler + ValidierungsMeldung setzen">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_spalten" name="Power Automate: Konformitaet, PDFAStatus, Status=Validiert setzen">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_gobd" name="Purview: _ComplianceTag lesen -&#62; GoBDArchiviert setzen">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_mon" name="Monitoring: im Dashboard sichtbar (KPIs, Filter, Deep-Link)">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_buchung" name="Buchhaltung: manuelle Buchung (XML rechtlich fuehrend)">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_ok" name="Rechnung verarbeitet &#38; GoBD-aufbewahrt">
      <bpmn:incoming>f27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_err" name="Fehler - Nachbearbeitung">
      <bpmn:incoming>f23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="se_out" targetRef="t_upload" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_upload" targetRef="t_felder" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_felder" targetRef="g_format" />
    <bpmn:sequenceFlow id="f4" name="XRechnung" sourceRef="g_format" targetRef="t_xr" />
    <bpmn:sequenceFlow id="f5" name="ZUGFeRD" sourceRef="g_format" targetRef="t_zf" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_xr" targetRef="g_format_m" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_zf" targetRef="g_format_m" />
    <bpmn:sequenceFlow id="f8" sourceRef="g_format_m" targetRef="t_pruef" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_pruef" targetRef="t_ar" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_ar" targetRef="t_trigger" />
    <bpmn:sequenceFlow id="f11" sourceRef="se_in" targetRef="t_erar" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_erar" targetRef="t_trigger" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_trigger" targetRef="t_call" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_call" targetRef="g_typ" />
    <bpmn:sequenceFlow id="f15" name="XML" sourceRef="g_typ" targetRef="t_kosit" />
    <bpmn:sequenceFlow id="f16" name="ZUGFeRD-PDF" sourceRef="g_typ" targetRef="t_pdf" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_kosit" targetRef="g_typ_m" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_pdf" targetRef="g_typ_m" />
    <bpmn:sequenceFlow id="f19" sourceRef="g_typ_m" targetRef="t_ergebnis" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_ergebnis" targetRef="g_konform" />
    <bpmn:sequenceFlow id="f21" name="rot / abgelehnt" sourceRef="g_konform" targetRef="t_fehler" />
    <bpmn:sequenceFlow id="f22" name="gruen / gelb" sourceRef="g_konform" targetRef="t_spalten" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_fehler" targetRef="e_err" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_spalten" targetRef="t_gobd" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_gobd" targetRef="t_mon" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_mon" targetRef="t_buchung" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_buchung" targetRef="e_ok" />
  </bpmn:process>
