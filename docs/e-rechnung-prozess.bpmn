<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ERechnung" targetNamespace="http://dihag.de/erechnung">
  <bpmn:collaboration id="Collab_ERechnung">
    <bpmn:participant id="Pool_ERechnung" name="DIHAG E-Rechnung (Ein- und Ausgang)" processRef="Process_ERechnung" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ERechnung" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Werk" name="Werk / ERP">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_erar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Konv" name="Konverter (E-Rechnung-App)">
        <bpmn:flowNodeRef>t_upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_felder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_format</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_xr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_zf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pruef</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SP" name="SharePoint (Rechnungsmonitoring)">
        <bpmn:flowNodeRef>t_ar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mon</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PA" name="Power Automate">
        <bpmn:flowNodeRef>t_trigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_konform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_spalten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fehler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_err</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Azure" name="Azure-Pruefdienste (KoSIT, veraPDF)">
        <bpmn:flowNodeRef>g_typ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_kosit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pdf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ergebnis</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GoBD" name="Purview (GoBD) &amp; Buchhaltung">
        <bpmn:flowNodeRef>t_gobd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_buchung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Neue Rechnung (Vorgang startet)">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_ea" name="Eingang oder Ausgang?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_erar" name="ERP-System: Rechnung in ERAR_&lt;Werk&gt; ablegen">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_upload" name="PDF hochladen oder Daten erfassen">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_felder" name="Belegart (BT-3) &amp; Felder pruefen; Werk aus Firmenname">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_format" name="Format?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_xr" name="XRechnung (XML) erzeugen">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_zf" name="ZUGFeRD-PDF (PDF/A-3b + XML) erzeugen">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_pruef" name="Selbstpruefung + Pruefpfad (SHA-256)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_ar" name="Ablage in AR_&lt;Werk&gt; mit Metadaten">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_trigger" name="Trigger &quot;Datei erstellt&quot; -&gt; Inhalt abrufen">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_call" name="POST /api/validate">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_typ" name="XML oder ZUGFeRD-PDF?">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_kosit" name="KoSIT prueft XRechnung-XML (EN 16931)">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_pdf" name="XML aus PDF extrahieren -&gt; KoSIT + veraPDF">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_ergebnis" name="Ergebnis: Konformitaet + PDF/A">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_konform" name="Konform?">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_spalten" name="Konformitaet, PDFAStatus, Status=Validiert setzen">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_fehler" name="Status=Fehler + ValidierungsMeldung setzen">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_err" name="Fehler - Nachbearbeitung">
      <bpmn:incoming>f22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_gobd" name="_ComplianceTag lesen -&gt; GoBDArchiviert setzen">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_mon" name="Im Monitoring-Dashboard sichtbar">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_buchung" name="Manuelle Buchung (XML rechtlich fuehrend)">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_ok" name="Rechnung verarbeitet &amp; GoBD-aufbewahrt">
      <bpmn:incoming>f26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="g_ea" />
    <bpmn:sequenceFlow id="f2" sourceRef="g_ea" targetRef="t_upload" name="Ausgang" />
    <bpmn:sequenceFlow id="f3" sourceRef="g_ea" targetRef="t_erar" name="Eingang" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_upload" targetRef="t_felder" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_felder" targetRef="g_format" />
    <bpmn:sequenceFlow id="f6" sourceRef="g_format" targetRef="t_xr" name="XRechnung" />
    <bpmn:sequenceFlow id="f7" sourceRef="g_format" targetRef="t_zf" name="ZUGFeRD" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_xr" targetRef="t_pruef" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_zf" targetRef="t_pruef" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_pruef" targetRef="t_ar" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_ar" targetRef="t_trigger" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_erar" targetRef="t_trigger" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_trigger" targetRef="t_call" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_call" targetRef="g_typ" />
    <bpmn:sequenceFlow id="f15" sourceRef="g_typ" targetRef="t_kosit" name="XML" />
    <bpmn:sequenceFlow id="f16" sourceRef="g_typ" targetRef="t_pdf" name="ZUGFeRD-PDF" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_kosit" targetRef="t_ergebnis" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_pdf" targetRef="t_ergebnis" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_ergebnis" targetRef="g_konform" />
    <bpmn:sequenceFlow id="f20" sourceRef="g_konform" targetRef="t_spalten" name="gruen / gelb (akzeptiert)" />
    <bpmn:sequenceFlow id="f21" sourceRef="g_konform" targetRef="t_fehler" name="rot (abgelehnt)" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_fehler" targetRef="e_err" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_spalten" targetRef="t_gobd" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_gobd" targetRef="t_mon" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_mon" targetRef="t_buchung" />
    <bpmn:sequenceFlow id="f26" sourceRef="t_buchung" targetRef="e_ok" />
  </bpmn:process>
